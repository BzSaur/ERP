<!-- Header -->
<div class="mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/tipos-actividad">Tipos de Actividad</a></li>
      <li class="breadcrumb-item active">Nuevo</li>
    </ol>
  </nav>
  <h4 class="mb-0">Crear Nuevo Tipo de Actividad</h4>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
<% } %>

<!-- Formulario -->
<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <form action="/admin/tipos-actividad" method="POST">
          <div class="mb-4">
            <label class="form-label">Nombre <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="Nombre" required
                   value="<%= (typeof datos !== 'undefined' && datos.Nombre) || '' %>"
                   placeholder="Ej: Venta, Capacitación, Instalación...">
          </div>

          <div class="mb-4">
            <label class="form-label">Color <span class="text-danger">*</span></label>
            <div class="d-flex align-items-center gap-2">
              <input type="color" class="form-control form-control-color" name="Color" id="inputColor"
                     value="<%= (typeof datos !== 'undefined' && datos.Color) || '#6f42c1' %>" title="Elige el color">
              <input type="text" class="form-control" id="colorHex" style="max-width:130px"
                     value="<%= (typeof datos !== 'undefined' && datos.Color) || '#6f42c1' %>" maxlength="7">
              <span class="badge px-3 py-2" id="previewBadge" style="background-color:<%= (typeof datos !== 'undefined' && datos.Color) || '#6f42c1' %>">Vista previa</span>
            </div>
            <small class="text-body-secondary">Identifica visualmente este tipo en las tablas de asistencia.</small>
          </div>

          <div class="d-flex gap-2">
            <a href="/admin/tipos-actividad" class="btn btn-outline-secondary">
              <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i> Guardar Tipo
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const picker = document.getElementById('inputColor');
  const hex = document.getElementById('colorHex');
  const badge = document.getElementById('previewBadge');
  function sync(v){ badge.style.backgroundColor = v; }
  picker.addEventListener('input', function(){ hex.value = picker.value; sync(picker.value); });
  hex.addEventListener('input', function(){
    if (/^#[0-9a-fA-F]{6}$/.test(hex.value)) { picker.value = hex.value; sync(hex.value); }
  });
})();
</script>
