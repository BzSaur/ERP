<!-- Header -->
<div class="mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/grupos">Grupos</a></li>
      <li class="breadcrumb-item active">Nuevo</li>
    </ol>
  </nav>
  <h4 class="mb-0">Crear Nuevo Grupo</h4>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <form action="/admin/grupos" method="POST">
          <div class="mb-3">
            <label class="form-label">Nombre del Grupo <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="Nombre_Grupo" required
                   placeholder="Ej: Turno Matutino, Cuadrilla Norte...">
          </div>

          <div class="mb-3">
            <label class="form-label">Encargado responsable <span class="text-danger">*</span></label>
            <select class="form-select" name="ID_Encargado" required>
              <option value="">Seleccionar...</option>
              <% encargados.forEach(function(e) { %>
              <option value="<%= e.ID_Encargado_Cat %>">
                <%= [e.empleado.Nombre, e.empleado.Apellido_Paterno].filter(Boolean).join(' ') %>
              </option>
              <% }); %>
            </select>
            <% if (!encargados || encargados.length === 0) { %>
              <small class="text-danger">No hay encargados designados. <a href="/admin/encargados/crear">Designa uno primero</a>.</small>
            <% } %>
          </div>

          <div class="mb-4">
            <label class="form-label">Descripción</label>
            <textarea class="form-control" name="Descripcion" rows="3" placeholder="Descripción opcional..."></textarea>
          </div>

          <div class="d-flex gap-2">
            <a href="/admin/grupos" class="btn btn-outline-secondary">
              <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i> Guardar Grupo
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
