<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
  <div>
    <h4 class="mb-1">Grupos</h4>
    <p class="text-body-secondary mb-0">Grupos de trabajo con encargado responsable y miembros de vigencia individual</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/grupos/wizard" class="btn btn-primary">
      <i class="bi bi-lightning-fill me-2"></i>
      Alta rápida
    </a>
    <a href="/admin/grupos/crear" class="btn btn-outline-secondary">
      <i class="bi bi-people-fill me-2"></i>
      Grupo básico
    </a>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Nombre del Grupo</th>
            <th>Encargado</th>
            <th class="text-center">Miembros</th>
            <th class="text-center">Estatus</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (grupos && grupos.length > 0) { %>
            <% grupos.forEach(function(g) { %>
            <tr>
              <td>
                <i class="bi bi-diagram-3 text-primary me-2"></i>
                <strong><%= g.Nombre_Grupo %></strong>
                <% if (g.Descripcion) { %><div class="text-body-secondary small"><%= g.Descripcion %></div><% } %>
              </td>
              <td><%= [g.encargado?.empleado?.Nombre, g.encargado?.empleado?.Apellido_Paterno].filter(Boolean).join(' ') || '—' %></td>
              <td class="text-center"><span class="badge bg-info"><%= g._count.miembros %></span></td>
              <td class="text-center">
                <% if (g.Activo) { %>
                  <span class="badge bg-success">Activo</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactivo</span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/admin/grupos/<%= g.ID_Grupo %>/editar" class="btn btn-sm btn-outline-primary" title="Editar / Miembros">
                  <i class="bi bi-pencil"></i>
                </a>
                <% if (g._count.miembros === 0) { %>
                <form action="/admin/grupos/<%= g.ID_Grupo %>/eliminar" method="POST" class="d-inline"
                      onsubmit="return confirm('¿Eliminar este grupo?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" class="text-center text-body-secondary py-4">No hay grupos registrados</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
