<!-- Header -->
<div class="mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/encargados">Encargados</a></li>
      <li class="breadcrumb-item active">Designar</li>
    </ol>
  </nav>
  <h4 class="mb-0">Designar Encargado</h4>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <form action="/admin/encargados" method="POST">
          <div class="mb-4">
            <label class="form-label">Empleado <span class="text-danger">*</span></label>
            <select class="form-select" name="ID_Empleado" required>
              <option value="">Seleccionar...</option>
              <% empleados.forEach(function(e) { %>
              <option value="<%= e.ID_Empleado %>">
                <%= [e.Nombre, e.Apellido_Paterno].filter(Boolean).join(' ') %>
              </option>
              <% }); %>
            </select>
            <small class="text-body-secondary">Recuerda asignarle el rol ENCARGADO en <a href="/usuarios">Usuarios</a> para que pueda acceder a sus rutas.</small>
          </div>

          <div class="d-flex gap-2">
            <a href="/admin/encargados" class="btn btn-outline-secondary">
              <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i> Designar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
