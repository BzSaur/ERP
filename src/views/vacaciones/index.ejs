<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
  <div>
    <h2 class="mb-1"><i class="bi bi-sun me-2"></i>Vacaciones</h2>
    <p class="text-body-secondary mb-0">Derecho a vacaciones e histórico de periodos <%= anioActual %></p>
  </div>
  <div class="d-flex gap-2">
    <form action="/vacaciones/generar" method="POST" class="d-inline">
      <button type="submit" class="btn btn-success">
        <i class="bi bi-arrow-repeat me-1"></i> Generar Vacaciones
      </button>
    </form>
    <a href="/vacaciones/crear" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Registrar
    </a>
  </div>
</div>

<% if (typeof messages !== 'undefined') { %>
  <% if (messages.success) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <i class="bi bi-check-circle me-2"></i><%= messages.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (messages.error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <i class="bi bi-exclamation-circle me-2"></i><%= messages.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (messages.info) { %>
    <div class="alert alert-info alert-dismissible fade show">
      <i class="bi bi-info-circle me-2"></i><%= messages.info %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
<% } %>

<!-- Estadísticas -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card stat-card bg-warning">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="stat-label">Pendientes</div>
            <div class="stat-value"><%= stats.pendientes %></div>
          </div>
          <i class="bi bi-hourglass-split stat-icon"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card bg-info">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="stat-label">En Curso</div>
            <div class="stat-value"><%= stats.enCurso %></div>
          </div>
          <i class="bi bi-airplane stat-icon"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card bg-success">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="stat-label">Tomadas</div>
            <div class="stat-value"><%= stats.tomadas %></div>
          </div>
          <i class="bi bi-check-circle stat-icon"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-body">
    <form action="/vacaciones" method="GET" class="row g-3 align-items-end">
      <input type="hidden" name="buscar" value="1">
      <div class="col-12 col-md-5">
        <label for="q" class="form-label">Buscar empleado</label>
        <input type="text" class="form-control" id="q" name="q"
               value="<%= filtros.q %>" placeholder="Nombre o apellido...">
      </div>
      <div class="col-12 col-md-4">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="soloElegibles"
                 name="soloElegibles" value="1" <%= filtros.soloElegibles ? 'checked' : '' %>>
          <label class="form-check-label" for="soloElegibles">
            Solo elegibles
            <% if (totalNoElegibles > 0) { %>
              <span class="text-body-secondary">(<%= totalNoElegibles %> con menos de 1 año)</span>
            <% } %>
          </label>
        </div>
      </div>
      <div class="col-12 col-md-3">
        <button type="submit" class="btn btn-primary me-2">
          <i class="bi bi-search me-1"></i> Filtrar
        </button>
        <a href="/vacaciones" class="btn btn-outline-secondary">Limpiar</a>
      </div>
    </form>
  </div>
</div>

<!-- Tabla -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th style="width:2.5rem"></th>
            <th>Empleado</th>
            <th class="text-center">Antigüedad</th>
            <th class="text-center">Días Corresp.</th>
            <th class="text-center">Días Tomados</th>
            <th class="text-center">Días Pend.</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% if (filas.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-body-secondary">
                No hay empleados que coincidan con el filtro
              </td>
            </tr>
          <% } else { %>
            <% filas.forEach(f => { %>
              <%
                const nombre = [f.Nombre, f.Apellido_Paterno, f.Apellido_Materno].filter(Boolean).join(' ');
                const fmt = d => new Date(d).toLocaleDateString('es-MX', { timeZone: 'UTC' });
              %>
              <tr>
                <td>
                  <% if (f.elegible) { %>
                    <button class="btn btn-sm btn-link p-0 text-body-secondary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#detalle-<%= f.ID_Empleado %>"
                            aria-expanded="false" title="Ver histórico y registrar">
                      <i class="bi bi-chevron-down"></i>
                    </button>
                  <% } %>
                </td>
                <td>
                  <strong><%= nombre %></strong>
                  <% if (f.puesto || f.area) { %>
                    <div class="small text-body-secondary">
                      <%= [f.puesto?.Nombre_Puesto, f.area?.Nombre_Area].filter(Boolean).join(' · ') %>
                    </div>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (f.antiguedad.anos > 0) { %>
                    <strong><%= f.antiguedad.anos %></strong> años
                    <% if (f.antiguedad.meses > 0) { %>
                      <span class="small text-body-secondary"><%= f.antiguedad.meses %> m</span>
                    <% } %>
                  <% } else { %>
                    <span class="small text-body-secondary"><%= f.antiguedad.meses %> meses</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <%= f.elegible ? f.diasCorrespondientes : '-' %>
                </td>
                <td class="text-center">
                  <%= f.elegible ? f.diasTomados : '-' %>
                </td>
                <td class="text-center">
                  <% if (f.elegible) { %>
                    <strong class="<%= f.diasPendientes > 0 ? 'text-success' : 'text-body-secondary' %>">
                      <%= f.diasPendientes %>
                    </strong>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td>
                  <% if (!f.elegible) { %>
                    <span class="badge bg-secondary">No elegible</span>
                  <% } else if (!f.vacacion) { %>
                    <span class="badge bg-warning text-dark">Pendiente generar</span>
                  <% } else if (f.vacacion.Estado === 'PENDIENTE') { %>
                    <span class="badge bg-warning text-dark">Pendiente</span>
                  <% } else if (f.vacacion.Estado === 'EN_CURSO') { %>
                    <span class="badge bg-info">En Curso</span>
                  <% } else if (f.vacacion.Estado === 'TOMADAS') { %>
                    <span class="badge bg-success">Tomadas</span>
                  <% } else { %>
                    <span class="badge bg-danger">Vencidas</span>
                  <% } %>
                </td>
              </tr>

              <% if (f.elegible) { %>
                <tr class="collapse" id="detalle-<%= f.ID_Empleado %>">
                  <td colspan="7" class="bg-body-tertiary">
                    <div class="row g-4 py-2">
                      <!-- Histórico de periodos -->
                      <div class="col-lg-7">
                        <h6 class="mb-2">Histórico de periodos</h6>
                        <% if (f.periodos.length === 0) { %>
                          <p class="small text-body-secondary mb-0">
                            Sin periodos registrados en <%= anioActual %>.
                          </p>
                        <% } else { %>
                          <div class="table-responsive">
                            <table class="table table-sm mb-0">
                              <thead>
                                <tr>
                                  <th>Desde</th>
                                  <th>Hasta</th>
                                  <th class="text-center">Días</th>
                                  <th>Estado</th>
                                  <th class="text-end">Acción</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% f.periodos.forEach(p => { %>
                                  <% const cancelado = p.Estado === 'CANCELADO'; %>
                                  <tr class="<%= cancelado ? 'text-body-secondary' : '' %>"
                                      style="<%= cancelado ? 'text-decoration:line-through;' : '' %>">
                                    <td><%= fmt(p.Fecha_Inicio) %></td>
                                    <td><%= fmt(p.Fecha_Fin) %></td>
                                    <td class="text-center"><%= p.Dias %></td>
                                    <td>
                                      <% if (cancelado) { %>
                                        <span class="badge bg-secondary">Cancelado</span>
                                      <% } else { %>
                                        <span class="badge bg-success">Aprobado</span>
                                      <% } %>
                                    </td>
                                    <td class="text-end">
                                      <a href="/vacaciones/periodos/<%= p.ID_Periodo_Vac %>/editar"
                                         class="btn btn-sm btn-outline-secondary"
                                         style="text-decoration:none">Editar</a>
                                    </td>
                                  </tr>
                                  <% if (p.Observaciones) { %>
                                    <tr class="<%= cancelado ? 'text-body-secondary' : '' %>">
                                      <td colspan="5" class="small pt-0 border-0"><%= p.Observaciones %></td>
                                    </tr>
                                  <% } %>
                                <% }) %>
                              </tbody>
                            </table>
                          </div>
                        <% } %>
                      </div>

                      <!-- Registrar nuevo periodo -->
                      <div class="col-lg-5">
                        <h6 class="mb-2">Registrar periodo</h6>
                        <form action="/vacaciones" method="POST" class="row g-2">
                          <input type="hidden" name="ID_Empleado" value="<%= f.ID_Empleado %>">
                          <div class="col-6">
                            <label class="form-label small mb-1">Desde</label>
                            <input type="date" class="form-control form-control-sm" name="Fecha_Inicio" required>
                          </div>
                          <div class="col-6">
                            <label class="form-label small mb-1">Hasta</label>
                            <input type="date" class="form-control form-control-sm" name="Fecha_Fin" required>
                          </div>
                          <div class="col-12">
                            <label class="form-label small mb-1">Observaciones</label>
                            <input type="text" class="form-control form-control-sm" name="Observaciones"
                                   placeholder="Opcional">
                          </div>
                          <div class="col-12">
                            <button type="submit" class="btn btn-sm btn-primary">
                              <i class="bi bi-check-lg me-1"></i>Registrar
                            </button>
                            <div class="form-text">
                              Quedan <strong><%= f.diasPendientes %></strong> día(s) pendientes.
                              Se aceptan fechas pasadas para capturar periodos ya gozados.
                            </div>
                          </div>
                        </form>
                      </div>
                    </div>
                  </td>
                </tr>
              <% } %>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Info LFT -->
<div class="card mt-4">
  <div class="card-header">
    <h6 class="mb-0"><i class="bi bi-info-circle me-1"></i> Días de Vacaciones según LFT México 2024</h6>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <table class="table table-sm">
          <thead>
            <tr><th>Antigüedad</th><th>Días</th></tr>
          </thead>
          <tbody>
            <tr><td>1 año</td><td>12 días</td></tr>
            <tr><td>2 años</td><td>14 días</td></tr>
            <tr><td>3 años</td><td>16 días</td></tr>
            <tr><td>4 años</td><td>18 días</td></tr>
            <tr><td>5 años</td><td>20 días</td></tr>
          </tbody>
        </table>
      </div>
      <div class="col-md-6">
        <table class="table table-sm">
          <thead>
            <tr><th>Antigüedad</th><th>Días</th></tr>
          </thead>
          <tbody>
            <tr><td>6-10 años</td><td>22 días</td></tr>
            <tr><td>11-15 años</td><td>24 días</td></tr>
            <tr><td>16-20 años</td><td>26 días</td></tr>
            <tr><td>21-25 años</td><td>28 días</td></tr>
            <tr><td>26-30 años</td><td>30 días</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="mb-0 small text-body-secondary">
      <i class="bi bi-asterisk"></i> Prima vacacional: 25% mínimo sobre salario de vacaciones (Art. 80 LFT)
    </p>
  </div>
</div>
