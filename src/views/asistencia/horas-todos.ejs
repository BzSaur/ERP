<%
function fmtH(n){ if(n==null) return '-'; const h=Math.floor(n); const m=Math.round((n-h)*60); if(h===0&&m===0) return '0'; if(h===0) return m+'m'; if(m===0) return h+'h'; return h+'h '+m+'m'; }
const urlExcelBase = typeof excelUrl !== 'undefined' && excelUrl ? excelUrl : '/asistencia/horas/excel';
// SuperAdmin en la vista por encargado: debe elegir uno antes de ver datos.
const delegando = typeof esSupervisorParaDelegar !== 'undefined' && esSupervisorParaDelegar;
const idEncSel = typeof idEncargadoPreseleccionado !== 'undefined' ? idEncargadoPreseleccionado : null;
const faltaElegirEncargado = delegando && !idEncSel;
%>
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
  <div>
    <h4 class="mb-1"><%= typeof title !== 'undefined' && title ? title : 'Consultar Horas' %></h4>
    <p class="text-body-secondary mb-0">Horas trabajadas por empleado (checadas en vivo). Clic en un empleado para el desglose diario.</p>
  </div>
  <% if (!delegando) { %>
  <a href="/checador" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-file-earmark-spreadsheet me-1"></i>Importar XLSX (respaldo)
  </a>
  <% } %>
</div>

<% if (delegando) { %>
<div class="card mb-3">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end" id="formEncargado">
      <input type="hidden" name="fechaInicio" value="<%= fechaInicio %>">
      <input type="hidden" name="fechaFin" value="<%= fechaFin %>">
      <div class="col-auto">
        <label class="form-label mb-1 small">Ver el equipo de</label>
        <select class="form-select form-select-sm" name="encargado" id="selEncargado" style="min-width:300px;">
          <option value="">Selecciona un encargado...</option>
          <% encargadosDisponibles.forEach(function(e) { %>
            <option value="<%= e.empleado.ID_Empleado %>" <%= idEncSel === e.empleado.ID_Empleado ? 'selected' : '' %>>
              <%= e.empleado.Nombre %> <%= e.empleado.Apellido_Paterno %> <%= e.empleado.Apellido_Materno || '' %>
            </option>
          <% }); %>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">
          <i class="bi bi-arrow-right me-1"></i>Ver equipo
        </button>
      </div>
      <div class="col-auto text-body-secondary small pb-2">
        <i class="bi bi-info-circle me-1"></i>El reporte se acota al equipo vigente del encargado elegido.
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
(function(){
  const sel = document.getElementById('selEncargado');
  const form = document.getElementById('formEncargado');
  if (!sel || !form) return;
  sel.addEventListener('change', function(){ if (sel.value) form.submit(); });
})();
</script>

<% if (faltaElegirEncargado) { %>
<div class="alert alert-info">
  <i class="bi bi-arrow-up me-1"></i>
  Elige un encargado arriba y pulsa <strong>Ver equipo</strong>.
  <a href="/asistencia/horas" class="alert-link ms-1">O consulta la tabla global de todos los empleados.</a>
</div>
<% } else { %>

<!-- Filtro con flatpickr (rango) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<form method="GET" class="card mb-4" id="formFiltro">
  <div class="card-body d-flex flex-wrap gap-3 align-items-end">
    <div style="min-width:260px">
      <label class="form-label small mb-1">Rango de fechas</label>
      <input type="text" id="rango" class="form-control form-control-sm" placeholder="Selecciona rango...">
      <input type="hidden" name="fechaInicio" id="fechaInicio" value="<%= fechaInicio %>">
      <input type="hidden" name="fechaFin" id="fechaFin" value="<%= fechaFin %>">
    </div>
    <div class="d-flex align-items-center gap-2">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" id="chkRedondear" name="redondear" value="1"
               <%= (typeof redondear !== 'undefined' && redondear) ? 'checked' : '' %>>
        <label class="form-check-label small" for="chkRedondear">Redondear horas</label>
      </div>
    </div>
    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>Filtrar</button>
    <a id="btnExcel" href="<%= urlExcelBase %>?fechaInicio=<%= fechaInicio %>&fechaFin=<%= fechaFin %><%= idEncSel ? '&encargado=' + idEncSel : '' %>"
       class="btn btn-sm btn-success">
      <i class="bi bi-file-earmark-excel me-1"></i>Descargar Excel
    </a>
    <span class="text-body-secondary small ms-auto align-self-center">
      Periodo: <%= new Date(datos.periodo.fechaInicio).toLocaleDateString('es-MX') %> – <%= new Date(datos.periodo.fechaFin).toLocaleDateString('es-MX') %>
    </span>
  </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
<script>
  const fpInicio = document.getElementById('fechaInicio');
  const fpFin = document.getElementById('fechaFin');
  const fp = flatpickr('#rango', {
    mode: 'range',
    locale: 'es',
    dateFormat: 'Y-m-d',
    defaultDate: [fpInicio.value, fpFin.value],
    onChange: function(dates) {
      if (dates.length === 2) {
        const f = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
        fpInicio.value = f(dates[0]);
        fpFin.value = f(dates[1]);
      }
    }
  });
</script>

<!-- Resumen por planta -->
<% if (datos.plantas && datos.plantas.length > 0) { %>
<div class="row g-3 mb-4">
  <% datos.plantas.forEach(function(p) { %>
  <div class="col-6 col-md-3">
    <div class="card border-primary">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="text-body-secondary small"><i class="bi bi-building me-1"></i><%= p.nombre %></div>
            <div class="fs-4 fw-bold"><%= fmtH(p.horas) %></div>
          </div>
          <span class="badge bg-light text-dark border align-self-center"><%= p.dias %> días</span>
        </div>
      </div>
    </div>
  </div>
  <% }); %>
</div>
<% } %>

<!-- Panel de revisiones (días <2h con checada: probable olvido de entrada/salida) -->
<% if (datos.totalRevisiones && datos.totalRevisiones > 0) { %>
<div class="card border-warning mb-4" id="panelRevisiones">
  <div class="card-header bg-warning bg-opacity-25 d-flex justify-content-between align-items-center">
    <span class="fw-semibold">
      <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
      <%= datos.totalRevisiones %> día(s) requieren revisión de RH
      <small class="text-body-secondary ms-1">(menos de <%= datos.umbralRevision %>h con checada — posible olvido de entrada/salida)</small>
    </span>
    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#listaRevisiones">
      Ver / ocultar
    </button>
  </div>
  <div class="collapse show" id="listaRevisiones">
    <div class="list-group list-group-flush">
      <% datos.revisiones.forEach(function(r){ %>
        <div class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2" data-rev-emp="<%= r.ID_Empleado %>">
          <div>
            <% if (hasRole('ADMIN','Administrador','RH','Recursos Humanos','RECURSOS_HUMANOS','SuperAdministrador')) { %>
            <a href="/asistencia/horas/<%= r.ID_Empleado %>?fechaInicio=<%= fechaInicio %>&fechaFin=<%= fechaFin %>" class="fw-semibold text-decoration-none">
              <%= r.nombre %>
            </a>
            <% } else { %><span class="fw-semibold"><%= r.nombre %></span><% } %>
            <% if (r.area) { %><small class="text-body-secondary ms-1"><%= r.area %></small><% } %>
            <div class="mt-1 d-flex flex-wrap gap-1">
              <% r.dias.forEach(function(d){ %>
                <span class="badge bg-warning text-dark" title="<%= d.motivo %> · entrada <%= d.entrada||'—' %> / salida <%= d.salida||'—' %>">
                  <%= d.nombreDia %> <%= new Date(d.fecha + 'T12:00:00').toLocaleDateString('es-MX', {day:'2-digit', month:'2-digit'}) %>:
                  <%= d.horas.toFixed(1) %>h · <%= d.motivo %>
                </span>
              <% }); %>
            </div>
          </div>
          <div class="d-flex gap-2 align-self-center">
            <% if (hasRole('ADMIN','Administrador','RH','Recursos Humanos','RECURSOS_HUMANOS','SuperAdministrador')) { %>
            <a href="/asistencia/horas/<%= r.ID_Empleado %>?fechaInicio=<%= fechaInicio %>&fechaFin=<%= fechaFin %>" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-eye me-1"></i>Revisar
            </a>
            <% } %>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-descartar-rev" data-rev-emp="<%= r.ID_Empleado %>">
              <i class="bi bi-check2 me-1"></i>Descartar
            </button>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</div>
<% } %>

<!-- Panel de actividades de campo (asistencia delegada por un encargado) -->
<% if (hasRole('ADMIN','Administrador','RH','Recursos Humanos','RECURSOS_HUMANOS','SuperAdministrador','ENCARGADO') && datos.totalActividades && datos.totalActividades > 0) { %>
<div class="card border-primary mb-4" id="panelActividadesCampo">
  <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
    <%
      let nPuntuales = 0, nRecurrentes = 0;
      datos.actividades.forEach(r => r.dias.forEach(d => d.esRecurrente ? nRecurrentes++ : nPuntuales++));
    %>
    <span class="fw-semibold">
      <i class="bi bi-signpost-split-fill text-primary me-2"></i>
      <%= nPuntuales %> día(s) de actividad asignada en este periodo
      <% if (nRecurrentes > 0) { %>
        <small class="text-body-secondary ms-1">
          + <%= nRecurrentes %> por recurrencia <i class="bi bi-arrow-repeat"></i>
        </small>
      <% } %>
      <small class="text-body-secondary ms-1">(no cuentan como falta)</small>
    </span>
    <div class="d-flex gap-2">
      <a href="/encargado" class="btn btn-sm btn-outline-primary">Ver actividades</a>
      <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#listaActividadesCampo">
        Ver / ocultar
      </button>
    </div>
  </div>
  <div class="collapse show" id="listaActividadesCampo">
    <div class="list-group list-group-flush">
      <%
        // Las asignaciones puntuales son las que requieren atención; las
        // recurrentes son la rutina ya definida y van atenuadas al final.
        const conPuntuales = datos.actividades.filter(r => r.dias.some(d => !d.esRecurrente));
        const soloRecurrentes = datos.actividades.filter(r => r.dias.every(d => d.esRecurrente));
      %>
      <% conPuntuales.forEach(function(r){ %>
        <div class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div>
            <span class="fw-semibold"><%= r.nombre %></span>
            <% if (r.area) { %><small class="text-body-secondary ms-1"><%= r.area %></small><% } %>
            <div class="mt-1 d-flex flex-wrap gap-1">
              <% r.dias.filter(d => !d.esRecurrente).forEach(function(d){ %>
                <span class="badge bg-primary bg-opacity-75" title="Tipo: <%= d.tipo %> · Encargado: <%= d.responsable %> · Actividad: <%= d.nombre %><%= d.empresa ? ' · Empresa: ' + d.empresa : '' %>">
                  <%= d.nombreDia %> <%= new Date(d.fecha + 'T12:00:00').toLocaleDateString('es-MX', {day:'2-digit', month:'2-digit'}) %>: <%= d.tipo %>
                </span>
              <% }); %>
              <% r.dias.filter(d => d.esRecurrente).forEach(function(d){ %>
                <span class="badge bg-light text-body-secondary border" title="Recurrente · <%= d.nombre %><%= d.empresa ? ' · ' + d.empresa : '' %>">
                  <i class="bi bi-arrow-repeat"></i>
                  <%= d.nombreDia %> <%= new Date(d.fecha + 'T12:00:00').toLocaleDateString('es-MX', {day:'2-digit', month:'2-digit'}) %>
                </span>
              <% }); %>
            </div>
          </div>
        </div>
      <% }); %>

      <% if (soloRecurrentes.length > 0) { %>
        <div class="list-group-item bg-body-tertiary py-1">
          <small class="text-body-secondary">
            <i class="bi bi-arrow-repeat me-1"></i>Recurrentes (rutina ya definida)
          </small>
        </div>
        <% soloRecurrentes.forEach(function(r){ %>
          <div class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2 py-2">
            <div class="text-body-secondary">
              <span class="fw-semibold"><%= r.nombre %></span>
              <% if (r.area) { %><small class="ms-1"><%= r.area %></small><% } %>
              <div class="mt-1 d-flex flex-wrap gap-1">
                <% r.dias.forEach(function(d){ %>
                  <span class="badge bg-light text-body-secondary border" title="Recurrente · <%= d.nombre %><%= d.empresa ? ' · ' + d.empresa : '' %>">
                    <i class="bi bi-arrow-repeat"></i>
                    <%= d.nombreDia %> <%= new Date(d.fecha + 'T12:00:00').toLocaleDateString('es-MX', {day:'2-digit', month:'2-digit'}) %>
                  </span>
                <% }); %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>
<% } %>

<!-- Matriz tipo checador (empleados × días) -->
<%
const DIAS = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
function fmtFechaCorta(d){ const x=new Date(d); return String(x.getDate()).padStart(2,'0')+'/'+String(x.getMonth()+1).padStart(2,'0'); }
%>
<style>
  .matriz-horas th, .matriz-horas td { font-size:.78rem; white-space:nowrap; }
  .matriz-horas .th-dom { background:#f1f3f5; }
  .matriz-horas .th-sab { background:#fff3cd; }
  .matriz-horas td.cel-completa { background:#d1e7dd; }
  .matriz-horas td.cel-parcial  { background:#fff3cd; }
  .matriz-horas td.cel-ausente  { background:#f8d7da; }
  .matriz-horas td.cel-vacacion { background:#cfe2ff; }
  /* Ausencia SIN goce de sueldo: justificada pero no pagada (no suma horas) */
  .matriz-horas td.cel-singoce  { background:#f5d9dc; }
  .matriz-horas td.cel-dom      { background:#f1f3f5; }
  .matriz-horas td.cel-revision { background:#ffe0b2; outline:2px solid #fd7e14; outline-offset:-2px; }
  .matriz-horas td.cel-revision .hrs { color:#d63384; }
  .matriz-horas td.cel-actividad { background:#e2d9f3; }
  .matriz-horas td.cel-actividad .cel-es .hrs { color:#6f42c1; }
  /* Detalle de actividad delegada dentro de la MISMA celda chica: tipo /
     actividad / empresa / encargado, truncados. El title de la celda ya trae
     el texto completo. */
  .cel-act-info { line-height:1.15; max-width:92px; margin:0 auto; }
  .cel-act-info > div { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  /* El nombre lleva el color del tipo (inline, desde Cat_Tipo_Actividad.Color) */
  .cel-act-info .act-nom { font-weight:700; font-size:.66rem; }
  .cel-act-info .act-hora { color:#495057; font-size:.62rem; font-variant-numeric:tabular-nums; font-weight:600; }
  .cel-act-info .act-emp { color:#495057; font-size:.6rem; }
  .cel-act-info .act-enc { color:#6c757d; font-size:.58rem; font-style:italic; }
  .matriz-horas .col-id  { position:sticky; left:0; background:#fff; z-index:2; min-width:48px; }
  .matriz-horas .col-emp { position:sticky; left:48px; background:#fff; z-index:2; min-width:190px; }
  .matriz-horas thead .col-id, .matriz-horas thead .col-emp { z-index:3; }
  .matriz-horas .cel-es { line-height:1.15; }
  .matriz-horas .cel-es .ent { color:#0d6efd; }
  .matriz-horas .cel-es .sal { color:#dc3545; }
  .matriz-horas .cel-es .hrs { font-weight:600; border-top:1px solid #ccc; }
  .matriz-horas th.sortable { cursor:pointer; user-select:none; }
  .matriz-horas th.sortable:hover { background:#e9ecef; }
  .matriz-horas th .arrow { font-size:.65rem; opacity:.5; }
</style>

<!-- Buscador -->
<div class="mb-3" style="max-width:340px">
  <div class="input-group input-group-sm">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input type="text" id="buscarEmp" class="form-control" placeholder="Buscar por nombre o ID...">
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-bordered table-sm mb-0 matriz-horas align-middle" id="tablaMatriz">
        <thead class="table-light">
          <tr>
            <th class="col-id text-center sortable" data-sort="id" data-type="num">ID <span class="arrow"></span></th>
            <th class="col-emp sortable" data-sort="nombre" data-type="str">Empleado <span class="arrow"></span></th>
            <% datos.fechas.forEach(function(f){ const dw=new Date(f).getDay(); %>
              <th class="text-center <%= dw===0?'th-dom':'' %> <%= dw===6?'th-sab':'' %>">
                <div class="small text-body-secondary"><%= DIAS[dw] %></div>
                <div><%= fmtFechaCorta(f) %></div>
              </th>
            <% }); %>
            <th class="text-center">Norm</th>
            <th class="text-center">Extra</th>
            <th class="text-center sortable" data-sort="total" data-type="num">Total <span class="arrow"></span></th>
            <th class="text-center">Ret</th>
          </tr>
        </thead>
        <tbody id="matrizBody">
          <% if (datos.filas && datos.filas.length > 0) { %>
            <% datos.filas.forEach(function(f) { %>
            <tr data-id="<%= f.ID_Empleado %>" data-nombre="<%= f.nombre.toLowerCase() %>" data-total="<%= f.horas %>">
              <td class="col-id text-center text-body-secondary"><%= f.ID_Empleado %></td>
              <td class="col-emp">
                <% if (hasRole('ADMIN','Administrador','RH','Recursos Humanos','RECURSOS_HUMANOS','SuperAdministrador')) { %>
                <a href="/asistencia/horas/<%= f.ID_Empleado %>?fechaInicio=<%= fechaInicio %>&fechaFin=<%= fechaFin %>" class="text-decoration-none fw-semibold">
                  <%= f.nombre %>
                </a>
                <% } else { %><span class="fw-semibold"><%= f.nombre %></span><% } %>
                <% if (f.multi > 0) { %><span class="badge bg-info ms-1" style="font-size:.6rem" title="<%= f.multi %> día(s) multi-planta">MP</span><% } %>
              </td>
              <% f.celdas.forEach(function(c, idxCelda){
                   const fechaCelda = datos.fechas[idxCelda] ? new Date(datos.fechas[idxCelda]).toISOString().slice(0,10) : '';
                   let cls='', tip='', bgStyle='';
                   // Tinte de fondo con el color propio del tipo de actividad
                   // (Cat_Tipo_Actividad.Color): 22 = ~13% de opacidad en hex.
                   const tinteActividad = c.actividad && c.actividad.color
                     ? 'background-color:' + c.actividad.color + '22;'
                     : '';
                   // Día de descanso (sáb/dom) SIN nada que mostrar. Quien vino
                   // a recuperar horas sí checó: esa celda se pinta como
                   // cualquier otra, si no el sábado trabajado desaparece.
                   const descansoVacio = c.esDomingo && !c.presente && !c.ausencia && !c.actividad;
                   if (descansoVacio) { cls='cel-dom'; }
                   else if (!c.presente && c.ausencia) {
                     cls = c.sinGoce ? 'cel-singoce' : 'cel-vacacion';
                     tip = c.ausencia + (c.sinGoce
                       ? ' · sin goce de sueldo — no suma horas'
                       : ' · 9h jornada cumplida (no cuenta como falta)');
                   }
                   else if (!c.presente && c.actividad) {
                     cls='cel-actividad'; bgStyle=tinteActividad;
                     tip='Tipo: ' + c.actividad.tipo + ' · Encargado: ' + c.actividad.responsable + ' · Actividad: ' + c.actividad.nombre + (c.actividad.empresa ? ' · Empresa: ' + c.actividad.empresa : '') + ' · 9h jornada cumplida';
                   }
                   else if (!c.presente && c.vacio) { cls='cel-ausente'; tip='Ausente'; }
                   else if (c.requiereRevision) { cls='cel-revision'; tip='Requiere revisión RH · ' + (c.horas||0).toFixed(1) + 'h (menos de 2h con checada)'; }
                   else if (c.enCurso) { cls='cel-parcial'; tip='En curso (sin salida)'; }
                   else if (c.incompleta) { cls='cel-parcial'; tip='Incompleta · estimada a 18:00'; }
                   else if (c.presente) {
                     cls = c.jornadaCompleta ? 'cel-completa' : '';
                     tip=(c.planta||'') + (c.ausencia ? ' · trabajó en periodo de ' + c.ausencia.toLowerCase() : '');
                     if (c.actividad) {
                       cls += ' cel-actividad'; bgStyle=tinteActividad;
                       tip += ' · Tipo: ' + c.actividad.tipo + ' · Encargado: ' + c.actividad.responsable + ' · Actividad: ' + c.actividad.nombre + (c.actividad.empresa ? ' · Empresa: ' + c.actividad.empresa : '');
                     }
                   }
              %>
                <td class="text-center <%= cls %> cel-dia<%= (typeof panelEditable !== 'undefined' && panelEditable && !descansoVacio) ? ' cel-editable' : '' %>"
                    style="<%= bgStyle %>"
                    title="<%= tip %>"
                    data-emp="<%= f.ID_Empleado %>"
                    data-fecha="<%= fechaCelda %>"
                    data-ent="<%= c.entrada || '' %>"
                    data-sal="<%= c.salida || '' %>"
                    data-horas="<%= c.horas || 0 %>"
                    data-presente="<%= c.presente ? 1 : 0 %>"
                    data-dom="<%= descansoVacio ? 1 : 0 %>"
                    data-vacio="<%= (!c.presente && c.vacio) ? 1 : 0 %>">
                  <% if (descansoVacio) { %>
                    <span class="text-body-secondary small"><%= new Date(fechaCelda + 'T00:00:00').getDay() === 6 ? 'Sáb' : 'Dom' %></span>
                  <% } else if (!c.presente && c.ausencia) { %>
                    <% if (c.sinGoce) { %>
                      <span class="fw-bold d-block" style="color:#b02a37; font-size:.7rem" title="<%= c.ausencia %> — sin goce de sueldo"><%= c.ausencia.length > 12 ? c.ausencia.slice(0,11) + '…' : c.ausencia %></span>
                      <span style="color:#b02a37; font-size:.64rem">sin goce</span>
                    <% } else { %>
                      <span class="text-primary fw-bold d-block"><%= c.ausencia === 'Vacaciones' ? 'Vac' : 'Perm' %></span>
                      <span class="text-primary" style="font-size:.68rem"><%= (c.horas||0).toFixed(1) %>h</span>
                    <% } %>
                  <% } else if (!c.presente && c.actividad) { %>
                    <%
                      const hhmmSA = (m) => Number.isFinite(m)
                        ? String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0') : null;
                      // Un día puede tener varias actividades: se listan todas.
                      const actsSA = c.actividad.todas || [c.actividad];
                    %>
                    <div class="cel-act-info">
                      <% actsSA.forEach(function(av, iSa){ %>
                        <% const sIni = hhmmSA(av.horaInicio), sFin = hhmmSA(av.horaFin); %>
                        <div class="<%= iSa > 0 ? 'mt-1 pt-1 border-top' : '' %>">
                          <div class="act-nom" style="color:<%= av.color %>" title="<%= av.nombre %>">
                            <%= av.nombre %><% if (av.esRecurrente) { %> <i class="bi bi-arrow-repeat"></i><% } %>
                          </div>
                          <% if (sIni && sFin) { %>
                            <div class="act-hora" title="Horario de la actividad"><%= sIni %>–<%= sFin %></div>
                          <% } %>
                        </div>
                      <% }); %>
                      <% if (c.actividad.empresa) { %><div class="act-emp" title="<%= c.actividad.empresa %>"><%= c.actividad.empresa %></div><% } %>
                      <% if (c.actividad.responsable) { %><div class="act-enc" title="Encargado: <%= c.actividad.responsable %>"><i class="bi bi-person-badge"></i> <%= c.actividad.responsable %></div><% } %>
                    </div>
                  <% } else if (!c.presente && c.vacio) { %>
                    <span class="text-danger fw-bold">Falta</span>
                  <% } else if (c.presente) { %>
                    <div class="cel-es">
                      <div class="ent"><%= c.entrada || '--:--' %></div>
                      <div class="sal"><%= c.salida || '--:--' %></div>
                      <% if (c.requiereRevision) { %>
                        <div class="hrs"><i class="bi bi-exclamation-triangle-fill text-warning"></i> <%= (c.horas||0).toFixed(1) %>h</div>
                      <% } else if (c.enCurso) { %>
                        <div class="hrs text-primary"><i class="bi bi-hourglass-split"></i> <%= (c.horas||0).toFixed(1) %>h</div>
                      <% } else { %>
                        <div class="hrs"><%= (c.horas||0).toFixed(1) %>h</div>
                      <% } %>
                      <% if (c.actividad) { %>
                        <%
                          const hhmmAct = (m) => Number.isFinite(m)
                            ? String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0') : null;
                          // Un día puede tener varias actividades: se listan todas.
                          const actsDia = c.actividad.todas || [c.actividad];
                        %>
                        <div class="cel-act-info mt-1 pt-1 border-top">
                          <% actsDia.forEach(function(av, iAv){ %>
                            <% const aIni = hhmmAct(av.horaInicio), aFin = hhmmAct(av.horaFin); %>
                            <div class="<%= iAv > 0 ? 'mt-1 pt-1 border-top' : '' %>">
                              <div class="act-nom" style="color:<%= av.color %>" title="<%= av.nombre %>">
                                <%= av.nombre %><% if (av.esRecurrente) { %> <i class="bi bi-arrow-repeat"></i><% } %>
                              </div>
                              <% if (aIni && aFin) { %>
                                <div class="act-hora" title="Horario de la actividad"><%= aIni %>–<%= aFin %></div>
                              <% } %>
                            </div>
                          <% }); %>
                          <% if (c.actividad.empresa) { %><div class="act-emp" title="<%= c.actividad.empresa %>"><%= c.actividad.empresa %></div><% } %>
                          <% if (c.actividad.responsable) { %><div class="act-enc" title="Encargado: <%= c.actividad.responsable %>"><i class="bi bi-person-badge"></i> <%= c.actividad.responsable %></div><% } %>
                        </div>
                      <% } %>
                    </div>
                  <% } else { %>-<% } %>
                </td>
              <% }); %>
              <td class="text-center col-normal"><%= f.normales>0?f.normales.toFixed(1):'-' %></td>
              <td class="text-center col-extra"><%= f.extras>0?f.extras.toFixed(1):'-' %></td>
              <td class="text-center fw-bold col-total"><%= f.horas>0?f.horas.toFixed(1):'0' %></td>
              <td class="text-center <%= f.retardos>0?'text-danger fw-bold':'' %>"><%= f.retardos>0?f.retardos:'-' %></td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="<%= datos.fechas.length + 6 %>" class="text-center text-body-secondary py-4">No hay empleados activos</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
(function(){
  const URL_EXCEL_BASE = <%- JSON.stringify(urlExcelBase) %>;
  const ID_ENCARGADO_SEL = <%- JSON.stringify(idEncSel) %>;
  const tbody = document.getElementById('matrizBody');
  const inputBuscar = document.getElementById('buscarEmp');
  const getRows = () => Array.from(tbody.querySelectorAll('tr[data-id]'));

  // --- Buscar por nombre o ID ---
  inputBuscar.addEventListener('input', function(){
    const q = this.value.toLowerCase().trim();
    getRows().forEach(tr => {
      const match = tr.dataset.nombre.includes(q) || tr.dataset.id.includes(q);
      tr.style.display = match ? '' : 'none';
    });
  });

  // Filtro directo por lista de IDs vía ?ids=1,2,3 (ej. enlazado desde un grupo).
  const paramsIds = new URLSearchParams(window.location.search).get('ids');
  if (paramsIds) {
    const idsSet = new Set(paramsIds.split(',').map(s => s.trim()));
    getRows().forEach(tr => {
      tr.style.display = idsSet.has(tr.dataset.id) ? '' : 'none';
    });
    inputBuscar.placeholder = idsSet.size + ' empleado(s) del grupo — escribe para buscar entre todos';
  }

  // --- Ordenar por columna ---
  let sortState = { key: null, asc: true };
  document.querySelectorAll('#tablaMatriz th.sortable').forEach(th => {
    th.addEventListener('click', function(){
      const key = this.dataset.sort;
      const type = this.dataset.type;
      sortState.asc = (sortState.key === key) ? !sortState.asc : true;
      sortState.key = key;

      const rows = getRows();
      rows.sort((a, b) => {
        let va = a.dataset[key], vb = b.dataset[key];
        if (type === 'num') { va = parseFloat(va)||0; vb = parseFloat(vb)||0; return sortState.asc ? va-vb : vb-va; }
        return sortState.asc ? va.localeCompare(vb) : vb.localeCompare(va);
      });
      rows.forEach(r => tbody.appendChild(r));

      // Flechas indicadoras
      document.querySelectorAll('#tablaMatriz th.sortable .arrow').forEach(a => a.textContent = '');
      this.querySelector('.arrow').textContent = sortState.asc ? '▲' : '▼';

      actualizarLinkExcel();
    });
  });

  // ---- Redondeo de horas ----
  function redondearEntrada(hhmm) {
    if (!hhmm) return hhmm;
    const [h, m] = hhmm.split(':').map(Number);
    if (m <= 15) return String(h).padStart(2,'0') + ':00';
    return String(h + 1).padStart(2,'0') + ':00';
  }
  function redondearSalida(hhmm) {
    if (!hhmm) return hhmm;
    const [h, m] = hhmm.split(':').map(Number);
    // Baja a la hora si faltan 5+ min para la siguiente (m<=55); sube solo en
    // los últimos 4 min (m>=56). Ej: 8:54->8:00, 8:56->9:00, 18:30->18:00.
    if (m <= 55) return String(h).padStart(2,'0') + ':00';
    return String(h + 1).padStart(2,'0') + ':00';
  }
  function minutosEntre(ent, sal) {
    const [he, me] = ent.split(':').map(Number);
    const [hs, ms] = sal.split(':').map(Number);
    const COMIDA_INI = 14*60, COMIDA_FIN = 15*60;
    const CIERRE = 18*60;
    const entMin = he*60+me, salMin = hs*60+ms;
    if (salMin <= entMin) return 0;
    let netos = salMin - entMin;
    // descuento comida si jornada cruza 14-15
    if (entMin < COMIDA_FIN && salMin > COMIDA_INI) {
      netos -= Math.min(salMin, COMIDA_FIN) - Math.max(entMin, COMIDA_INI);
    }
    return Math.max(0, netos);
  }

  const chk = document.getElementById('chkRedondear');
  const LIMITE_SEMANAL = 45; // tope de horas normales; excedente = extra
  function aplicarRedondeo() {
    const activo = chk.checked;
    // Recalcular celda por celda y totalizar por fila para reflejar el redondeo
    // en Total / Normal / Extra (split semanal de 45h).
    getRows().forEach(tr => {
      let totalFila = 0;
      tr.querySelectorAll('.cel-dia').forEach(td => {
        if (td.dataset.dom === '1' || td.dataset.vacio === '1' || td.dataset.presente !== '1') return;
        const entRaw = td.dataset.ent;
        const salRaw = td.dataset.sal;
        const horasRaw = parseFloat(td.dataset.horas) || 0;
        const celEs = td.querySelector('.cel-es');
        if (!celEs) return;

        let entMostrar, salMostrar, horasMostrar;
        if (activo && entRaw && salRaw) {
          entMostrar = redondearEntrada(entRaw);
          salMostrar = redondearSalida(salRaw);
          const mins = minutosEntre(entMostrar, salMostrar);
          horasMostrar = Math.round((mins / 60) * 10) / 10;
        } else {
          entMostrar = entRaw || '--:--';
          salMostrar = salRaw || '--:--';
          horasMostrar = Math.round(horasRaw * 10) / 10;
        }
        celEs.querySelector('.ent').textContent = entMostrar;
        celEs.querySelector('.sal').textContent = salMostrar;
        celEs.querySelector('.hrs').textContent = horasMostrar.toFixed(1) + 'h';
        totalFila += horasMostrar;
      });

      totalFila = Math.round(totalFila * 100) / 100;
      const extra = Math.max(0, Math.round((totalFila - LIMITE_SEMANAL) * 100) / 100);
      const normal = Math.round((totalFila - extra) * 100) / 100;
      const tdNorm = tr.querySelector('.col-normal');
      const tdExtra = tr.querySelector('.col-extra');
      const tdTotal = tr.querySelector('.col-total');
      if (tdNorm) tdNorm.textContent = normal > 0 ? normal.toFixed(1) : '-';
      if (tdExtra) tdExtra.textContent = extra > 0 ? extra.toFixed(1) : '-';
      if (tdTotal) tdTotal.textContent = totalFila > 0 ? totalFila.toFixed(1) : '0';
      tr.dataset.total = totalFila; // mantener orden por total coherente
    });
  }
  chk.addEventListener('change', aplicarRedondeo);
  // Aplicar estado inicial si viene con ?redondear=1
  if (chk.checked) aplicarRedondeo();

  // El botón Excel actualiza su href con fechas + orden + redondeo vivos
  const btnExcel = document.getElementById('btnExcel');
  function actualizarLinkExcel(){
    if (!btnExcel) return;
    const fi = document.getElementById('fechaInicio').value;
    const ff = document.getElementById('fechaFin').value;
    let url = `${URL_EXCEL_BASE}?fechaInicio=${fi}&fechaFin=${ff}`;
    if (ID_ENCARGADO_SEL) url += `&encargado=${ID_ENCARGADO_SEL}`;
    if (sortState.key) url += `&sort=${sortState.key}&dir=${sortState.asc ? 'asc' : 'desc'}`;
    if (document.getElementById('chkRedondear').checked) url += '&redondear=1';
    btnExcel.href = url;
  }
  if (btnExcel) btnExcel.addEventListener('click', actualizarLinkExcel);
  chk.addEventListener('change', actualizarLinkExcel);

  // --- Revisiones <2h: descartar (solo UI/sesión) + confirmar antes de descargar ---
  const panel = document.getElementById('panelRevisiones');
  function pendientesRevision(){
    if (!panel) return [];
    return Array.from(panel.querySelectorAll('.list-group-item:not([data-descartada])'));
  }
  // Descartar una persona de la lista (no persiste; solo oculta para esta sesión)
  document.querySelectorAll('.btn-descartar-rev').forEach(btn => {
    btn.addEventListener('click', function(){
      const item = this.closest('.list-group-item');
      item.setAttribute('data-descartada', '1');
      item.style.opacity = '.45';
      item.querySelectorAll('a, button').forEach(el => { el.classList.add('disabled'); el.setAttribute('tabindex','-1'); });
      this.innerHTML = '<i class="bi bi-check2-all me-1"></i>Revisado';
      // Si ya no quedan pendientes, atenuar el header del panel
      if (pendientesRevision().length === 0) {
        panel.querySelector('.card-header').classList.add('bg-opacity-10');
      }
    });
  });
  // Confirmar antes de descargar Excel si hay días sin revisar
  if (btnExcel) {
    btnExcel.addEventListener('click', function(ev){
      const pend = pendientesRevision();
      if (pend.length === 0) return; // nada que revisar
      const nombres = pend.map(i => i.querySelector('.fw-semibold')?.textContent.trim()).filter(Boolean);
      const lista = nombres.slice(0, 8).join(', ') + (nombres.length > 8 ? `, +${nombres.length - 8} más` : '');
      const ok = window.confirm(
        `Hay ${pend.length} persona(s) con días de menos de 2h (posible olvido de checada):\n\n${lista}\n\n` +
        `Revisa o descarta antes de exportar. ¿Descargar el Excel de todas formas?`
      );
      if (!ok) ev.preventDefault();
    });
  }
})();
</script>
<% } %>

<% if (typeof panelEditable !== 'undefined' && panelEditable) { %>
<!-- Panel lateral: detalle del día + edición de la actividad delegada -->
<style>
  .cel-editable { cursor:pointer; }
  .cel-editable:hover { outline:2px solid #6f42c1; outline-offset:-2px; }
  #panelDia .dato-lbl { font-size:.72rem; color:#6c757d; text-transform:uppercase; }
  #panelDia .dato-val { font-weight:600; }
</style>

<div class="offcanvas offcanvas-end" tabindex="-1" id="panelDia" style="width:420px">
  <div class="offcanvas-header border-bottom">
    <div>
      <h6 class="offcanvas-title mb-0" id="panelNombre">—</h6>
      <small class="text-body-secondary" id="panelFecha">—</small>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <div id="panelCargando" class="text-center text-body-secondary py-4">
      <div class="spinner-border spinner-border-sm me-2"></div>Cargando...
    </div>

    <div id="panelContenido" class="d-none">
      <div class="card mb-3">
        <div class="card-header py-2"><strong class="small">Checadas reales</strong></div>
        <div class="card-body py-2" id="panelChecadas"></div>
      </div>

      <div id="panelAusenciaWrap" class="alert alert-primary py-2 d-none">
        <i class="bi bi-calendar-check me-1"></i><span id="panelAusencia"></span>
      </div>

      <div class="card mb-3">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
          <strong class="small">Actividad delegada</strong>
          <span class="badge bg-secondary d-none" id="panelBadgeRec"><i class="bi bi-arrow-repeat"></i> Recurrente</span>
        </div>
        <div class="card-body">
          <div id="panelSinActividad" class="text-body-secondary small mb-3 d-none">
            Sin actividad asignada este día.
          </div>
          <!-- Día cubierto por una regla semanal: lo que se guarda es una
               excepción de ESE día; la regla no se toca. -->
          <div class="alert alert-info py-2 px-3 small d-none" id="panelAvisoRec">
            <i class="bi bi-info-circle me-1"></i>
            Este día lo cubre una <strong>recurrencia</strong>. Si lo cambias, se guarda como
            <strong>excepción solo de este día</strong> — la regla sigue aplicando las demás semanas.
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">Nombre de la actividad</label>
            <input type="text" class="form-control form-control-sm" id="panelNombreAct" placeholder="Ej: Instalación en obra">
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">Tipo</label>
            <select class="form-select form-select-sm" id="panelTipo"></select>
          </div>
          <div class="mb-3">
            <label class="form-label small mb-1">Empresa</label>
            <select class="form-select form-select-sm" id="panelEmpresa"></select>
          </div>

          <!-- Tramo horario del día: es lo útil cuando YA hubo checada y la
               actividad cubre otra parte de la jornada. Vacío = implícito. -->
          <div class="mb-3 d-none" id="panelHorasWrap">
            <label class="form-label small mb-1">Horario de la actividad</label>
            <div class="row g-2">
              <div class="col-6">
                <input type="time" class="form-control form-control-sm" id="panelHoraIni" title="Desde">
              </div>
              <div class="col-6">
                <input type="time" class="form-control form-control-sm" id="panelHoraFin" title="Hasta">
              </div>
            </div>
            <div class="d-flex justify-content-between align-items-start mt-1 gap-2">
              <small class="text-body-secondary" id="panelHorasAyuda" style="font-size:.72rem"></small>
              <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none flex-shrink-0" id="panelHorasGuardar" style="font-size:.75rem">
                Guardar horario
              </button>
            </div>
          </div>

          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="panelRecurrente">
            <label class="form-check-label small" for="panelRecurrente" id="panelRecLabel">
              <i class="bi bi-arrow-repeat"></i> Repetir cada semana este día
            </label>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-primary flex-grow-1" id="panelGuardar">
              <i class="bi bi-check-lg me-1"></i>Asignar
            </button>
            <button type="button" class="btn btn-sm btn-outline-success d-none" id="panelAgregar"
                    title="Suma otra actividad a este día, sin quitar la que ya está">
              <i class="bi bi-plus-lg me-1"></i>Agregar otra
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger d-none" id="panelQuitar">
              <i class="bi bi-trash me-1"></i>Quitar
            </button>
          </div>
          <div class="small text-danger mt-2 d-none" id="panelError"></div>
          <a href="#" id="panelLinkDetalle" class="small d-none d-block mt-2">
            <i class="bi bi-box-arrow-up-right me-1"></i>Abrir la actividad completa
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const el = document.getElementById('panelDia');
  if (!el) return;
  const oc = new bootstrap.Offcanvas(el);
  const $ = function(id){ return document.getElementById(id); };
  // SuperAdmin delegando: todas las llamadas van a nombre del encargado elegido.
  const encDelegado = <%- JSON.stringify(delegando ? idEncSel : null) %>;
  let ctx = { emp: null, fecha: null, tieneActividad: false };

  function opciones(sel, items, valueKey, labelKey, seleccionado) {
    sel.innerHTML = '<option value="">Seleccionar...</option>' + items.map(function(i){
      const s = String(i[valueKey]) === String(seleccionado) ? ' selected' : '';
      return '<option value="' + i[valueKey] + '"' + s + '>' + i[labelKey] + '</option>';
    }).join('');
  }

  function mostrarError(msg) {
    const e = $('panelError');
    e.textContent = msg || '';
    e.classList.toggle('d-none', !msg);
  }

  document.querySelectorAll('td.cel-editable').forEach(function(td){
    td.addEventListener('click', function(){
      ctx = { emp: td.dataset.emp, fecha: td.dataset.fecha, tieneActividad: false, idActividad: null, idAsignacion: null, idRecurrencia: null, esRecurrente: false };
      if (!ctx.emp || !ctx.fecha) return;

      $('panelCargando').classList.remove('d-none');
      $('panelContenido').classList.add('d-none');
      mostrarError('');
      oc.show();

      fetch('/encargado/asistencia/dia?empleado=' + ctx.emp + '&fecha=' + ctx.fecha +
            (encDelegado ? '&encargado=' + encDelegado : ''))
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (!d.ok) { mostrarError(d.error || 'No se pudo cargar el día'); $('panelCargando').classList.add('d-none'); return; }

          $('panelNombre').textContent = d.empleado.nombre;
          $('panelFecha').textContent = new Date(d.fecha + 'T12:00:00')
            .toLocaleDateString('es-MX', { weekday:'long', day:'2-digit', month:'long' }) +
            (d.empleado.area ? ' · ' + d.empleado.area : '');

          const ch = $('panelChecadas');
          if (d.asistencia) {
            let h = '<div class="row g-2 mb-2">' +
              '<div class="col-4"><div class="dato-lbl">Entrada</div><div class="dato-val">' + (d.asistencia.entrada || '--:--') + '</div></div>' +
              '<div class="col-4"><div class="dato-lbl">Salida</div><div class="dato-val">' + (d.asistencia.salida || '--:--') + '</div></div>' +
              '<div class="col-4"><div class="dato-lbl">Horas</div><div class="dato-val">' + d.asistencia.horas.toFixed(1) + 'h</div></div>' +
              '</div>';
            if (d.asistencia.plantaEntrada) h += '<div class="small text-body-secondary">Planta: ' + d.asistencia.plantaEntrada + '</div>';
            if (d.asistencia.minutosRetardo > 0) h += '<div class="small text-danger">Retardo: ' + d.asistencia.minutosRetardo + ' min</div>';
            if (d.asistencia.checadas.length) {
              h += '<div class="mt-2 d-flex flex-wrap gap-1">' + d.asistencia.checadas.map(function(c){
                return '<span class="badge bg-light text-dark border">' + c.hora + ' ' + c.tipo + '</span>';
              }).join('') + '</div>';
            }
            ch.innerHTML = h;
          } else {
            ch.innerHTML = '<div class="text-body-secondary small">Sin checadas registradas este día.</div>';
          }

          const aw = $('panelAusenciaWrap');
          if (d.ausencia) {
            aw.classList.remove('d-none');
            $('panelAusencia').textContent = d.ausencia.etiqueta + ' · 9h jornada cumplida' +
              (d.ganador === 'ACTIVIDAD' ? ' (desplazada por la actividad, asignada después)' : '');
          } else {
            aw.classList.add('d-none');
          }

          const act = d.actividad;
          ctx.tieneActividad = !!act;
          ctx.idActividad = act ? act.ID_Actividad : null;
          ctx.idRecurrencia = act ? act.ID_Recurrencia : null;
          ctx.esRecurrente = !!(act && act.esRecurrente);

          // Enlace a la pantalla de detalle correspondiente, para gestionar
          // todos los días de la actividad o la regla completa.
          const linkDet = $('panelLinkDetalle');
          if (act && (act.ID_Actividad || act.ID_Recurrencia)) {
            linkDet.href = act.esRecurrente
              ? '/encargado/recurrencias/' + act.ID_Recurrencia
              : '/encargado/actividades/' + act.ID_Actividad;
            linkDet.textContent = act.esRecurrente ? 'Abrir la regla completa' : 'Abrir la actividad completa';
            linkDet.classList.remove('d-none');
          } else {
            linkDet.classList.add('d-none');
          }
          $('panelSinActividad').classList.toggle('d-none', !!act);
          $('panelBadgeRec').classList.toggle('d-none', !(act && act.esRecurrente));
          $('panelQuitar').classList.toggle('d-none', !act);
          // Agregar otra solo tiene sentido si ya hay algo ese día.
          $('panelAgregar').classList.toggle('d-none', !act);
          $('panelQuitar').title = ctx.esRecurrente
            ? 'Detiene la regla completa (deja de aplicar todas las semanas)'
            : 'Quita la actividad de este día';
          $('panelGuardar').innerHTML = act
            ? '<i class="bi bi-check-lg me-1"></i>Actualizar'
            : '<i class="bi bi-check-lg me-1"></i>Asignar';

          $('panelNombreAct').value = act ? act.nombre : '';
          // En un día cubierto por recurrencia el switch arranca APAGADO: lo
          // normal es registrar una excepción de ese día, no reescribir la
          // regla de todas las semanas.
          $('panelRecurrente').checked = false;
          $('panelAvisoRec').classList.toggle('d-none', !ctx.esRecurrente);
          $('panelRecLabel').innerHTML = ctx.esRecurrente
            ? '<i class="bi bi-arrow-repeat"></i> Reemplazar la regla de todas las semanas'
            : '<i class="bi bi-arrow-repeat"></i> Repetir cada semana este día';

          // Horario: siempre disponible. En un día recurrente sirve para
          // capturar el tramo de la actividad ADICIONAL que se va a agregar
          // (ej. una guardia de 19-21 sobre el home office recurrente).
          ctx.idAsignacion = act ? act.ID_Asignacion : null;
          const aHHMM = m => Number.isFinite(m)
            ? String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0')
            : '';
          // En recurrentes los campos arrancan vacíos: son para la nueva.
          $('panelHoraIni').value = (act && !ctx.esRecurrente) ? aHHMM(act.horaInicio) : '';
          $('panelHoraFin').value = (act && !ctx.esRecurrente) ? aHHMM(act.horaFin) : '';
          $('panelHorasAyuda').textContent = ctx.esRecurrente
            ? 'Necesario para agregar otra actividad a este día.'
            : (act && Number.isFinite(act.horaInicio) && Number.isFinite(act.horaFin))
              ? 'Solo cuenta este tramo; se suma a lo que marcó el checador.'
              : (d.asistencia
                  ? 'Vacío: cuenta desde las 8:00 hasta su primera checada.'
                  : 'Vacío: cuenta jornada completa (9h).');
          // Guardar solo el horario aplica a una asignación puntual existente.
          $('panelHorasGuardar').classList.toggle('d-none', !act || !act.ID_Asignacion || ctx.esRecurrente);
          $('panelHorasWrap').classList.remove('d-none');

          let tipoSel = '', empSel = '';
          if (act) {
            const t = d.tiposActividad.filter(function(x){ return x.Nombre === act.tipo; })[0];
            if (t) tipoSel = t.ID_Tipo_Actividad;
            const em = d.empresas.filter(function(x){ return x.Nombre_Empresa === act.empresa; })[0];
            if (em) empSel = em.ID_Empresa;
          }
          opciones($('panelTipo'), d.tiposActividad, 'ID_Tipo_Actividad', 'Nombre', tipoSel);
          opciones($('panelEmpresa'), d.empresas, 'ID_Empresa', 'Nombre_Empresa', empSel);

          $('panelCargando').classList.add('d-none');
          $('panelContenido').classList.remove('d-none');
        })
        .catch(function(){ mostrarError('Error de conexión'); $('panelCargando').classList.add('d-none'); });
    });
  });

  function enviarToggle(body, onOk) {
    mostrarError('');
    if (encDelegado) body.ID_Encargado_Empleado = encDelegado;
    fetch('/encargado/actividades/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
      .then(function(r){ return r.json(); })
      .then(function(res){
        if (!res.ok) { mostrarError(res.error || 'No se pudo guardar'); return; }
        onOk(res);
      })
      .catch(function(){ mostrarError('Error de conexión'); });
  }

  $('panelGuardar').addEventListener('click', function(){
    const nombre = $('panelNombreAct').value.trim();
    const tipo = $('panelTipo').value;
    const empresa = $('panelEmpresa').value;
    if (!nombre || !tipo || !empresa) { mostrarError('Completa nombre, tipo y empresa'); return; }

    const quiereRecurrente = $('panelRecurrente').checked;
    const body = {
      ID_Empleado: parseInt(ctx.emp),
      fecha: ctx.fecha,
      modo: quiereRecurrente ? 'RECURRENTE' : 'PUNTUAL',
      Nombre_Actividad: nombre,
      ID_Tipo_Actividad: tipo,
      ID_Empresa: empresa
    };

    // Horario capturado en el mismo paso (solo aplica a puntuales).
    if (!quiereRecurrente) {
      const hI = $('panelHoraIni').value, hF = $('panelHoraFin').value;
      if (!!hI !== !!hF) { mostrarError('Captura ambas horas, o deja las dos vacías'); return; }
      if (hI && hF && hF <= hI) { mostrarError('La hora de fin debe ser posterior a la de inicio'); return; }
      if (hI && hF) { body.Hora_Inicio = hI; body.Hora_Fin = hF; }
    }

    // Actividad PUNTUAL existente que sigue siendo puntual: UPDATE real sobre
    // la actividad, sin borrar ni recrear el día (conserva ID e histórico).
    // Ojo: afecta a TODOS los días de esa actividad, no solo a este.
    if (ctx.idActividad && !ctx.esRecurrente && !quiereRecurrente) {
      mostrarError('');
      fetch('/encargado/actividades/' + ctx.idActividad + '/datos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Nombre_Actividad: nombre, ID_Tipo_Actividad: tipo, ID_Empresa: empresa })
      })
        .then(function(r){ return r.json(); })
        .then(function(res){
          if (!res.ok) { mostrarError(res.error || 'No se pudo actualizar'); return; }
          if (res.diasAfectados > 1) {
            alert('Actualizado. El cambio aplica a los ' + res.diasAfectados + ' días de esta actividad.');
          }
          window.location.reload();
        })
        .catch(function(){ mostrarError('Error de conexión'); });
      return;
    }

    // Si había una RECURRENTE y ahora se quiere puntual, el backend crea la
    // puntual encima (gana sobre la regla) — no hay que quitar nada primero.
    // Si había puntual, el backend la reemplaza al detectar datos distintos.
    // Solo el paso a recurrente sobre una recurrente existente necesita
    // detener la regla previa.
    if (ctx.tieneActividad && ctx.esRecurrente && quiereRecurrente) {
      enviarToggle({ ID_Empleado: body.ID_Empleado, fecha: body.fecha, modo: 'RECURRENTE' }, function(){
        enviarToggle(body, function(){ window.location.reload(); });
      });
    } else {
      enviarToggle(body, function(){ window.location.reload(); });
    }
  });

  // Sumar OTRA actividad al mismo día, sin quitar la que ya está.
  $('panelAgregar').addEventListener('click', function(){
    const nombre = $('panelNombreAct').value.trim();
    const tipo = $('panelTipo').value;
    const empresa = $('panelEmpresa').value;
    const hI = $('panelHoraIni').value, hF = $('panelHoraFin').value;
    if (!nombre || !tipo || !empresa) { mostrarError('Completa nombre, tipo y empresa'); return; }
    if (!hI || !hF) { mostrarError('Para agregar otra actividad al día, captura su horario'); return; }
    if (hF <= hI) { mostrarError('La hora de fin debe ser posterior a la de inicio'); return; }

    const body = {
      agregar: true,
      ID_Empleado: parseInt(ctx.emp),
      fecha: ctx.fecha,
      modo: 'PUNTUAL',
      Nombre_Actividad: nombre,
      ID_Tipo_Actividad: tipo,
      ID_Empresa: empresa,
      Hora_Inicio: hI,
      Hora_Fin: hF
    };
    if (encDelegado) body.ID_Encargado_Empleado = encDelegado;

    mostrarError('');
    fetch('/encargado/actividades/toggle', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
    })
      .then(function(r){ return r.json(); })
      .then(function(res){
        if (!res.ok) { mostrarError(res.error || 'No se pudo agregar'); return; }
        window.location.reload();
      })
      .catch(function(){ mostrarError('Error de conexión'); });
  });

  // Guardar solo el tramo horario, sin tocar el resto de la actividad.
  $('panelHorasGuardar').addEventListener('click', function(){
    if (!ctx.idAsignacion) return;
    const ini = $('panelHoraIni').value;
    const fin = $('panelHoraFin').value;
    if (!!ini !== !!fin) { mostrarError('Captura ambas horas, o deja las dos vacías'); return; }
    if (ini && fin && fin <= ini) { mostrarError('La hora de fin debe ser posterior a la de inicio'); return; }

    mostrarError('');
    fetch('/encargado/actividades/asignacion/' + ctx.idAsignacion + '/horas-json', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ Hora_Inicio: ini, Hora_Fin: fin })
    })
      .then(function(r){ return r.json(); })
      .then(function(res){
        if (!res.ok) { mostrarError(res.error || 'No se pudo guardar el horario'); return; }
        window.location.reload();
      })
      .catch(function(){ mostrarError('Error de conexión'); });
  });

  $('panelQuitar').addEventListener('click', function(){
    enviarToggle({
      ID_Empleado: parseInt(ctx.emp),
      fecha: ctx.fecha,
      modo: $('panelRecurrente').checked ? 'RECURRENTE' : 'PUNTUAL'
    }, function(){ window.location.reload(); });
  });
})();
</script>
<% } %>

