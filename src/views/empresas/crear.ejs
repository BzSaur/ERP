<!-- Header -->
<div class="mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/empresas">Empresas</a></li>
      <li class="breadcrumb-item active">Nueva</li>
    </ol>
  </nav>
  <h4 class="mb-0">Crear Nueva Empresa</h4>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
<% } %>

<!-- Formulario -->
<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <form action="/empresas" method="POST">
          <div class="mb-3">
            <label class="form-label">Nombre de la Empresa <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="Nombre_Empresa" required
                   value="<%= (typeof datos !== 'undefined' && datos.Nombre_Empresa) || '' %>"
                   placeholder="Ej: Cliente XYZ S.A. de C.V.">
          </div>

          <div class="mb-4">
            <label class="form-label">Descripción</label>
            <textarea class="form-control" name="Descripcion" rows="3"
                      placeholder="Descripción opcional..."><%= (typeof datos !== 'undefined' && datos.Descripcion) || '' %></textarea>
          </div>

          <div class="d-flex gap-2">
            <a href="/empresas" class="btn btn-outline-secondary">
              <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i> Guardar Empresa
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
