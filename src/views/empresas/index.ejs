<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
  <div>
    <h4 class="mb-1">Empresas</h4>
    <p class="text-body-secondary mb-0">Empresas cliente para actividades de campo (encargados)</p>
  </div>
  <a href="/empresas/crear" class="btn btn-primary">
    <i class="bi bi-building-add me-2"></i>
    Nueva Empresa
  </a>
</div>

<!-- Tabla de Empresas -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Nombre de la Empresa</th>
            <th>Descripción</th>
            <th class="text-center">Actividades</th>
            <th class="text-center">Estatus</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (empresas && empresas.length > 0) { %>
            <% empresas.forEach(function(empresa) { %>
            <tr>
              <td>
                <i class="bi bi-building text-primary me-2"></i>
                <strong><%= empresa.Nombre_Empresa %></strong>
              </td>
              <td><%= empresa.Descripcion || '-' %></td>
              <td class="text-center">
                <span class="badge bg-info"><%= empresa._count.actividades %></span>
              </td>
              <td class="text-center">
                <% if (empresa.Activo) { %>
                  <span class="badge bg-success">Activa</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactiva</span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/empresas/<%= empresa.ID_Empresa %>/editar" class="btn btn-sm btn-outline-primary" title="Editar">
                  <i class="bi bi-pencil"></i>
                </a>
                <% if (empresa._count.actividades === 0) { %>
                <form action="/empresas/<%= empresa.ID_Empresa %>/eliminar" method="POST" class="d-inline"
                      onsubmit="return confirm('¿Eliminar esta empresa?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" class="text-center text-body-secondary py-4">No hay empresas registradas</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
