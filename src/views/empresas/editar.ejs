<!-- Header -->
<div class="mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/empresas">Empresas</a></li>
      <li class="breadcrumb-item active">Editar</li>
    </ol>
  </nav>
  <h4 class="mb-0">Editar Empresa: <%= empresa.Nombre_Empresa %></h4>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
<% } %>

<!-- Formulario -->
<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <form action="/empresas/<%= empresa.ID_Empresa %>" method="POST">
          <div class="mb-3">
            <label class="form-label">Nombre de la Empresa <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="Nombre_Empresa"
                   value="<%= empresa.Nombre_Empresa %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea class="form-control" name="Descripcion" rows="3"><%= empresa.Descripcion || '' %></textarea>
          </div>

          <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" name="Activo" id="chkActivo" <%= empresa.Activo ? 'checked' : '' %>>
            <label class="form-check-label" for="chkActivo">Empresa activa</label>
          </div>

          <div class="d-flex gap-2">
            <a href="/empresas" class="btn btn-outline-secondary">
              <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-1"></i> Guardar Cambios
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
