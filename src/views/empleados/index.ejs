<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
  <div>
    <h2 class="mb-1"><i class="bi bi-people-fill me-2"></i>Empleados</h2>
    <p class="text-body-secondary mb-0">Gestión del personal de la empresa</p>
  </div>
  <a href="/empleados/crear" class="btn btn-primary flex-shrink-0">
    <i class="bi bi-plus-lg me-1"></i> Nuevo Empleado
  </a>
</div>

  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <!-- Filtros -->
  <div class="card mb-4">
    <div class="card-body">
      <form method="GET" action="/empleados" class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Buscar</label>
          <input type="text" name="buscar" class="form-control" placeholder="Nombre, apellido, número..." value="<%= filtros.buscar || '' %>">
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label">Área</label>
          <select name="area" class="form-select">
            <option value="">Todas las áreas</option>
            <% if (typeof areas !== 'undefined' && areas) { %>
              <% areas.forEach(function(area) { %>
                <option value="<%= area.ID_Area %>" <%= filtros.area == area.ID_Area ? 'selected' : '' %>><%= area.Nombre_Area %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Estatus</label>
          <select name="estatus" class="form-select">
            <option value="">Todos</option>
            <% if (typeof estatusList !== 'undefined' && estatusList) { %>
              <% estatusList.forEach(function(est) { %>
                <option value="<%= est.ID_Estatus %>" <%= filtros.estatus == est.ID_Estatus ? 'selected' : '' %>><%= est.Nombre_Estatus %></option>
              <% }); %>
            <% } %>
          </select>
        </div>
        <% const filtrosAvanzados = filtros.id || filtros.mes_nacimiento || filtros.fecha_ingreso || filtros.telefono; %>
        <div class="col-md-3 d-flex align-items-end gap-2">
          <button type="submit" class="btn btn-outline-primary">
            <i class="bi bi-search me-1"></i> Filtrar
          </button>
          <a href="/empleados" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i> Limpiar
          </a>
          <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#masFiltros" aria-expanded="<%= filtrosAvanzados ? 'true' : 'false' %>">
            <i class="bi bi-sliders me-1"></i> Más filtros
          </button>
        </div>

        <div class="collapse <%= filtrosAvanzados ? 'show' : '' %>" id="masFiltros">
          <div class="row g-3 mt-0">
            <div class="col-6 col-md-3">
              <label class="form-label">ID Empleado</label>
              <input type="number" name="id" class="form-control" placeholder="ID" value="<%= filtros.id || '' %>">
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label">Mes de nacimiento</label>
              <select name="mes_nacimiento" class="form-select">
                <option value="">Todos</option>
                <% const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre']; %>
                <% meses.forEach(function(nombreMes, i) { %>
                  <option value="<%= i + 1 %>" <%= filtros.mes_nacimiento == (i + 1) ? 'selected' : '' %>><%= nombreMes %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label">Fecha de ingreso</label>
              <input type="date" name="fecha_ingreso" class="form-control" value="<%= filtros.fecha_ingreso || '' %>">
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label">Teléfono</label>
              <input type="text" name="telefono" class="form-control" placeholder="Celular o emergencia" value="<%= filtros.telefono || '' %>">
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Tabla de empleados -->
  <% const qsFiltros = `buscar=${encodeURIComponent(filtros.buscar || '')}&area=${encodeURIComponent(filtros.area || '')}&estatus=${encodeURIComponent(filtros.estatus || '')}&id=${encodeURIComponent(filtros.id || '')}&mes_nacimiento=${encodeURIComponent(filtros.mes_nacimiento || '')}&fecha_ingreso=${encodeURIComponent(filtros.fecha_ingreso || '')}&telefono=${encodeURIComponent(filtros.telefono || '')}`; %>
  <%
    // Clic en columna ordena asc; reclic en la misma columna alterna. Siempre
    // arranca ascendente (igual que el filtro por texto: primer clic = A-Z / 1-N).
    // campo es literal fijo (no viene de request); qsFiltros ya va
    // URL-encoded y el href se imprime escapado (evita inyección en el atributo).
    function hrefOrden(campo) {
      const activo = filtros.sort === campo;
      const siguienteDir = (activo && filtros.dir === 'asc') ? 'desc' : 'asc';
      return `?${qsFiltros}&sort=${campo}&dir=${siguienteDir}`;
    }
    function flechaOrden(campo) {
      if (filtros.sort !== campo) return '';
      return filtros.dir === 'asc' ? ' ▲' : ' ▼';
    }
  %>
  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">
        <i class="bi bi-table me-2"></i>Lista de Empleados
        <span class="badge bg-secondary ms-2"><%= pagination.total %></span>
      </h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th style="width:2.5rem"></th>
            <th><a href="<%= hrefOrden('id') %>" class="text-body text-decoration-none">No. Empleado<%= flechaOrden('id') %></a></th>
            <th><a href="<%= hrefOrden('nombre') %>" class="text-body text-decoration-none">Nombre<%= flechaOrden('nombre') %></a></th>
            <th>RFC</th>
            <th>Área</th>
            <th>Puesto</th>
            <th>Horario</th>
            <th>Estatus</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof empleados !== 'undefined' && empleados && empleados.length > 0) { %>
            <% const verSalario = hasRole('ADMIN', 'Administrador', 'RH', 'Recursos Humanos', 'RECURSOS_HUMANOS', 'SuperAdministrador', 'SUPER_ADMIN'); %>
            <% empleados.forEach(function(emp) { %>
              <tr>
                <td>
                  <button class="btn btn-sm btn-link p-0 text-body-secondary" type="button"
                          data-bs-toggle="collapse" data-bs-target="#detalle-<%= emp.ID_Empleado %>"
                          aria-expanded="false" title="Ver más datos">
                    <i class="bi bi-chevron-down"></i>
                  </button>
                </td>
                <td><strong><%= emp.ID_Empleado %></strong></td>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="avatar-circle me-2">
                      <%= emp.Nombre ? emp.Nombre.charAt(0).toUpperCase() : '?' %><%= emp.Apellido_Paterno ? emp.Apellido_Paterno.charAt(0).toUpperCase() : '' %>
                    </div>
                    <div>
                      <div><%= emp.Nombre %> <%= emp.Apellido_Paterno %> <%= emp.Apellido_Materno || '' %></div>
                      <small class="text-body-secondary"><%= emp.Correo_Electronico || '' %></small>
                    </div>
                  </div>
                </td>
                <td><%= emp.RFC || '-' %></td>
                <td><%= emp.area ? emp.area.Nombre_Area : '-' %></td>
                <td><%= emp.puesto ? emp.puesto.Nombre_Puesto : '-' %></td>
                <td><%= emp.tipo_horario ? emp.tipo_horario.Nombre_Horario : '-' %></td>
                <td>
                  <% if (emp.estatus && emp.estatus.Nombre_Estatus === 'ACTIVO') { %>
                    <span class="badge bg-success"><%= emp.estatus.Nombre_Estatus %></span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= emp.estatus ? emp.estatus.Nombre_Estatus : '-' %></span>
                  <% } %>
                </td>
                <td class="text-end">
                  <a href="/empleados/<%= emp.ID_Empleado %>" class="btn btn-sm btn-outline-info" title="Ver">
                    <i class="bi bi-eye"></i>
                  </a>
                  <% if (verSalario) { %>
                  <a href="/empleados/<%= emp.ID_Empleado %>/editar" class="btn btn-sm btn-outline-primary" title="Editar">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <% } %>
                </td>
              </tr>
              <tr class="collapse" id="detalle-<%= emp.ID_Empleado %>">
                <td colspan="9" class="bg-body-tertiary">
                  <div class="row g-3 py-2">
                    <% if (verSalario) { %>
                    <div class="col-6 col-md-3">
                      <div class="small text-body-secondary">Sueldo mensual</div>
                      <strong><%= emp.Salario_Mensual ? '$' + Number(emp.Salario_Mensual).toLocaleString('es-MX', {minimumFractionDigits:2}) : '-' %></strong>
                    </div>
                    <% } %>
                    <div class="col-6 col-md-3">
                      <div class="small text-body-secondary">Posición</div>
                      <strong><%= emp.puesto ? emp.puesto.Nombre_Puesto : '-' %></strong>
                    </div>
                    <div class="col-6 col-md-3">
                      <div class="small text-body-secondary">Teléfono</div>
                      <strong><%= emp.Telefono_Celular || '-' %></strong>
                    </div>
                    <div class="col-6 col-md-3">
                      <div class="small text-body-secondary">Horario</div>
                      <strong><%= emp.tipo_horario ? emp.tipo_horario.Nombre_Horario : '-' %></strong>
                    </div>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center text-body-secondary py-4">No se encontraron empleados</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (pagination.totalPages > 1) { %>
    <!-- Paginación -->
    <% const qs = `${qsFiltros}&sort=${filtros.sort || ''}&dir=${filtros.dir || ''}`; %>
    <div class="card-footer">
      <nav>
        <ul class="pagination pagination-sm mb-0 justify-content-center">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page - 1 %>&<%= qs %>">
              <i class="bi bi-chevron-left"></i>
            </a>
          </li>
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= p %>&<%= qs %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= pagination.page + 1 %>&<%= qs %>">
              <i class="bi bi-chevron-right"></i>
            </a>
          </li>
        </ul>
      </nav>
      <p class="text-center text-body-secondary small mb-0 mt-2">
        Mostrando página <%= pagination.page %> de <%= pagination.totalPages %> (<%= pagination.total %> registros)
      </p>
    </div>
    <% } %>
  </div>
