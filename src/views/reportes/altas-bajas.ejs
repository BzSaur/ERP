<%
  const nombresMes = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const fmt = (d) => new Date(d).toLocaleDateString('es-MX', { timeZone: 'UTC' });
  const neto = altas.length - bajas.length;
%>
<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
  <div>
    <nav aria-label="breadcrumb" class="d-print-none">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/reportes">Reportes</a></li>
        <li class="breadcrumb-item active">Altas y Bajas</li>
      </ol>
    </nav>
    <h4 class="mb-0">Reporte de Altas y Bajas - <%= year %></h4>
  </div>
  <div class="d-flex gap-2 d-print-none">
    <form action="/reportes/altas-bajas" method="GET" class="d-flex gap-2">
      <select name="year" class="form-select" data-autosubmit>
        <% years.forEach(function(y) { %>
        <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
        <% }); %>
      </select>
      <noscript><button type="submit" class="btn btn-primary">Filtrar</button></noscript>
    </form>
    <button type="button" class="btn btn-outline-primary" data-print>
      <i class="bi bi-printer me-2"></i>Imprimir
    </button>
  </div>
</div>

<!-- Resumen -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-body-secondary small">Plantilla al 1-ene</div>
      <div class="fs-2 fw-bold"><%= plantillaInicio %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-body-secondary small">Altas / Bajas</div>
      <div class="fs-2 fw-bold">
        <span class="text-success"><%= altas.length %></span> / <span class="text-danger"><%= bajas.length %></span>
      </div>
      <div class="small text-body-secondary">Neto: <%= neto > 0 ? '+' + neto : neto %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-body-secondary small">Plantilla al cierre</div>
      <div class="fs-2 fw-bold"><%= plantillaFin %></div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-body-secondary small">Rotación anual</div>
      <div class="fs-2 fw-bold"><%= rotacion %>%</div>
      <div class="small text-body-secondary">bajas / plantilla promedio</div>
    </div></div>
  </div>
</div>

<!-- Movimiento por mes -->
<div class="card mb-4">
  <div class="card-header"><h5 class="card-title mb-0">Movimiento por mes</h5></div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead class="table-light">
          <tr><th>Mes</th><th class="text-end">Altas</th><th class="text-end">Bajas</th><th class="text-end">Neto</th></tr>
        </thead>
        <tbody>
          <% meses.forEach(function(m) { const n = m.altas - m.bajas; %>
          <tr class="<%= (m.altas + m.bajas) === 0 ? 'text-body-secondary' : '' %>">
            <td><%= nombresMes[m.mes] %></td>
            <td class="text-end"><%= m.altas %></td>
            <td class="text-end"><%= m.bajas %></td>
            <td class="text-end"><%= n > 0 ? '+' + n : n %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Altas -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-success text-white">
        <h5 class="card-title mb-0">Altas en <%= year %> (<%= altas.length %>)</h5>
      </div>
      <div class="card-body p-0">
        <% if (altas.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
              <tr><th>Nombre</th><th>Área</th><th>Puesto</th><th>Ingreso</th></tr>
            </thead>
            <tbody>
              <% altas.forEach(function(emp) { %>
              <tr>
                <td><%= emp.Nombre %> <%= emp.Apellido_Paterno %></td>
                <td><%= emp.area ? emp.area.Nombre_Area : '-' %></td>
                <td><%= emp.puesto ? emp.puesto.Nombre_Puesto : '-' %></td>
                <td><%= fmt(emp.Fecha_Ingreso) %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="text-center text-body-secondary py-4">No hay altas registradas en este año</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Bajas -->
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-danger text-white">
        <h5 class="card-title mb-0">Bajas en <%= year %> (<%= bajas.length %>)</h5>
      </div>
      <div class="card-body p-0">
        <% if (bajas.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
              <tr><th>Nombre</th><th>Área</th><th>Puesto</th><th>Baja</th></tr>
            </thead>
            <tbody>
              <% bajas.forEach(function(emp) { %>
              <tr>
                <td><%= emp.Nombre %> <%= emp.Apellido_Paterno %></td>
                <td><%= emp.area ? emp.area.Nombre_Area : '-' %></td>
                <td><%= emp.puesto ? emp.puesto.Nombre_Puesto : '-' %></td>
                <td><%= fmt(emp.Fecha_Baja) %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="text-center text-body-secondary py-4">No hay bajas registradas en este año</div>
        <% } %>
      </div>
    </div>
  </div>
</div>
