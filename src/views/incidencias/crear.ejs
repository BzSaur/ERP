<% const esJustificacion = preEmpleado && preFecha; %>
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
  <div>
    <h2 class="mb-1">
      <i class="bi bi-<%= esJustificacion ? 'check2-square' : 'clipboard-plus' %> me-2"></i>
      <%= esJustificacion ? 'Justificar Falta' : 'Registrar Falta o Permiso' %>
    </h2>
    <p class="text-body-secondary mb-0">
      <%= esJustificacion
        ? 'Indica el motivo de la ausencia detectada por el checador'
        : 'Registrar una ausencia para un empleado' %>
    </p>
  </div>
  <a href="/incidencias" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Volver
  </a>
</div>

<% if (esJustificacion) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    Falta detectada el <strong><%= new Date(preFecha + 'T12:00:00').toLocaleDateString('es-MX', { weekday:'long', day:'2-digit', month:'long', year:'numeric' }) %></strong>.
    Al guardar, el día deja de contar como falta injustificada.
  </div>
<% } %>

<% if (typeof messages !== 'undefined' && messages.error) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <i class="bi bi-exclamation-circle me-2"></i><%= messages.error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card">
  <div class="card-body">
    <form action="/incidencias" method="POST">
      <div class="row g-3">
        <div class="col-md-12">
          <label for="ID_Empleado" class="form-label">Empleado *</label>
          <select class="form-select" id="ID_Empleado" name="ID_Empleado" required>
            <option value="">Seleccionar empleado...</option>
            <% empleados.forEach(function(e) { %>
              <option value="<%= e.ID_Empleado %>" <%= preEmpleado === e.ID_Empleado ? 'selected' : '' %>>
                <%= e.Nombre %> <%= e.Apellido_Paterno %> <%= e.Apellido_Materno || '' %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-12">
          <label for="selTipo" class="form-label">Tipo de incidencia *</label>
          <select class="form-select" id="selTipo" name="ID_Tipo_Incidencia" required>
            <option value="">Seleccionar tipo...</option>
            <% tipos.forEach(function(t) { %>
              <option value="<%= t.ID_Tipo_Incidencia %>"
                      data-goce="<%= t.Con_Goce_Sueldo ? '1' : '0' %>"
                      data-doc="<%= t.Requiere_Documento ? '1' : '0' %>"
                      data-max="<%= t.Dias_Maximos || '' %>"
                      data-desc="<%= t.Descripcion || '' %>"><%= t.Nombre %></option>
            <% }) %>
          </select>
          <div class="form-text" id="descTipo">El tipo define si la ausencia se paga y si requiere documento</div>
        </div>

        <div class="col-md-4">
          <label for="fIni" class="form-label">Fecha de Inicio *</label>
          <input type="date" class="form-control" id="fIni" name="Fecha_Inicio" required value="<%= preFecha || '' %>">
        </div>

        <div class="col-md-4">
          <label for="fFin" class="form-label">Fecha de Fin *</label>
          <input type="date" class="form-control" id="fFin" name="Fecha_Fin" required value="<%= preFecha || '' %>">
        </div>

        <div class="col-md-4">
          <label for="diasCalc" class="form-label">Días</label>
          <input type="text" class="form-control" id="diasCalc" readonly value="—">
          <div class="form-text" id="avisoFuturo" style="display:none">
            <i class="bi bi-calendar-check text-info"></i> Permiso anticipado
          </div>
        </div>

        <div class="col-md-6">
          <label for="txtFolio" class="form-label" id="lblDoc">Documento comprobatorio</label>
          <input type="text" class="form-control" id="txtFolio" name="Folio_Documento" placeholder="Folio o referencia">
          <!-- Tiene_Documento se deriva de si hay folio: no se pregunta aparte. -->
          <input type="hidden" name="Tiene_Documento" id="hidDoc" value="">
          <div class="form-text" id="ayudaDoc">Opcional para este tipo</div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Goce de sueldo</label>
          <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" name="Con_Goce_Sueldo" id="chkGoce">
            <label class="form-check-label" for="chkGoce">Con goce de sueldo</label>
          </div>
          <div class="form-text">Con goce el día cuenta 9h; sin goce se etiqueta pero no suma horas</div>
        </div>

        <div class="col-md-12">
          <label for="Observaciones" class="form-label">Observaciones</label>
          <textarea class="form-control" id="Observaciones" name="Observaciones" rows="2" placeholder="Motivo o detalles..."></textarea>
        </div>
      </div>

      <hr class="my-4">

      <div class="d-flex justify-content-end gap-2">
        <a href="/incidencias" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-check-lg me-1"></i> Registrar
        </button>
      </div>
    </form>
  </div>
</div>

<script>
(function(){
  const sel = document.getElementById('selTipo');
  const chkGoce = document.getElementById('chkGoce');
  const desc = document.getElementById('descTipo');
  const fIni = document.getElementById('fIni');
  const fFin = document.getElementById('fFin');
  const diasCalc = document.getElementById('diasCalc');
  const txtFolio = document.getElementById('txtFolio');
  const hidDoc = document.getElementById('hidDoc');
  const lblDoc = document.getElementById('lblDoc');
  const ayudaDoc = document.getElementById('ayudaDoc');

  // El documento se marca solo si se capturó folio: no hay checkbox aparte.
  function sincronizarDoc(){
    hidDoc.value = txtFolio.value.trim() ? 'on' : '';
  }
  txtFolio.addEventListener('input', function(){
    sincronizarDoc();
    txtFolio.classList.remove('is-invalid');
  });

  // Al elegir tipo, precargar su goce por defecto y marcar si el documento
  // es obligatorio para ese tipo.
  const descPorDefecto = desc.textContent;
  sel.addEventListener('change', function(){
    const o = sel.selectedOptions[0];
    if (!o || !o.value) { desc.textContent = descPorDefecto; return; }
    chkGoce.checked = o.dataset.goce === '1';

    const obligatorio = o.dataset.doc === '1';
    txtFolio.required = obligatorio;
    lblDoc.innerHTML = 'Documento comprobatorio' + (obligatorio ? ' <span class="text-danger">*</span>' : '');
    ayudaDoc.textContent = obligatorio
      ? 'Obligatorio para este tipo'
      : 'Opcional para este tipo';

    const partes = [];
    if (o.dataset.desc) partes.push(o.dataset.desc);
    if (o.dataset.max) partes.push('Máximo ' + o.dataset.max + ' día(s)');
    desc.textContent = partes.join(' · ') || descPorDefecto;
    calcular();
  });

  // Contador de días en vivo.
  function calcular(){
    if (!fIni.value || !fFin.value) { diasCalc.value = '—'; return; }
    const a = new Date(fIni.value + 'T00:00:00'), b = new Date(fFin.value + 'T00:00:00');
    if (b < a) { diasCalc.value = 'rango inválido'; return; }
    const n = Math.round((b - a) / 86400000) + 1;
    const max = sel.selectedOptions[0]?.dataset.max;
    diasCalc.value = n + (max && n > +max ? ' (excede el máximo de ' + max + ')' : '');

    // Avisar si el permiso es para fechas que aún no llegan.
    const hoy = new Date(); hoy.setHours(0,0,0,0);
    const aviso = document.getElementById('avisoFuturo');
    if (aviso) aviso.style.display = a > hoy ? '' : 'none';
  }
  fIni.addEventListener('change', function(){ if (!fFin.value || fFin.value < fIni.value) fFin.value = fIni.value; calcular(); });
  fFin.addEventListener('change', calcular);
  calcular();
})();
</script>
