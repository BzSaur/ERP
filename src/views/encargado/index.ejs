<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
  <div>
    <h4 class="mb-1"><i class="bi bi-signpost-split me-2"></i>Actividades de Campo</h4>
    <p class="text-body-secondary mb-0">
      Con los datos de abajo llenos, <strong>clic o arrastre</strong> asigna (y reemplaza lo que hubiera).
      Sin ellos, el clic en un día ocupado <strong>abre el panel</strong> para editarlo.
      Los días con recurrencia se marcan con <i class="bi bi-arrow-repeat"></i>.
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/encargado/asistencia" class="btn btn-outline-primary">
      <i class="bi bi-table me-1"></i>Asistencia de mi Equipo
    </a>
  </div>
</div>

<% if (messages.success) { %>
<div class="alert alert-success alert-dismissible fade show" role="alert">
  <i class="bi bi-check-circle me-2"></i><%= messages.success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>
<% if (messages.error) { %>
<div class="alert alert-danger alert-dismissible fade show" role="alert">
  <i class="bi bi-exclamation-triangle me-2"></i><%= messages.error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>
<% if (messages.info) { %>
<div class="alert alert-info alert-dismissible fade show" role="alert">
  <i class="bi bi-info-circle me-2"></i><%= messages.info %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<% if (esSupervisorParaDelegar) { %>
<div class="card mb-3">
  <div class="card-body">
    <form method="GET" action="/encargado" class="row g-2 align-items-end" id="formEncargado">
      <div class="col-auto">
        <label class="form-label mb-1 small">Ver el equipo de</label>
        <select class="form-select form-select-sm" name="encargado" id="selEncargado" style="min-width:280px;">
          <option value="">Selecciona un encargado...</option>
          <% encargadosDisponibles.forEach(function(e) { %>
            <option value="<%= e.empleado.ID_Empleado %>" <%= idEncargadoPreseleccionado === e.empleado.ID_Empleado ? 'selected' : '' %>>
              <%= e.empleado.Nombre %> <%= e.empleado.Apellido_Paterno %> <%= e.empleado.Apellido_Materno || '' %>
            </option>
          <% }); %>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">
          <i class="bi bi-arrow-right me-1"></i>Ver equipo
        </button>
      </div>
      <div class="col-auto text-body-secondary small pb-2">
        <i class="bi bi-info-circle me-1"></i>Como SuperAdmin puedes delegar a nombre de cualquier encargado.
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
(function(){
  const sel = document.getElementById('selEncargado');
  const form = document.getElementById('formEncargado');
  if (!sel || !form) return;
  sel.addEventListener('change', function(){ if (sel.value) form.submit(); });
})();
</script>

<% if (esSupervisorParaDelegar && !idEncargadoPreseleccionado) { %>
<div class="alert alert-info">Elige un encargado arriba y pulsa <strong>Ver equipo</strong>.</div>
<% } else if (!equipo || equipo.length === 0) { %>
<div class="alert alert-warning">
  No hay empleados vigentes en este equipo. Un SuperAdmin debe agregar miembros en <a href="/admin/grupos">Grupos</a>.
</div>
<% } else { %>

<!-- Filtro de rango + valores por defecto de la actividad -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<form method="GET" action="/encargado" class="card mb-3" id="formRango">
  <div class="card-body d-flex flex-wrap gap-3 align-items-end">
    <% if (esSupervisorParaDelegar) { %>
      <input type="hidden" name="encargado" value="<%= idEncargadoPreseleccionado %>">
    <% } %>
    <div style="min-width:250px">
      <label class="form-label small mb-1">Rango de fechas</label>
      <input type="text" id="rango" class="form-control form-control-sm" placeholder="Selecciona rango...">
      <input type="hidden" name="fechaInicio" id="fechaInicio" value="<%= fechaInicio %>">
      <input type="hidden" name="fechaFin" id="fechaFin" value="<%= fechaFin %>">
    </div>
    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>Ver rango</button>
    <span class="text-body-secondary small ms-auto align-self-center">
      <%= fechas.length %> día(s) laborables · <%= equipo.length %> empleado(s)
    </span>
  </div>
</form>

<div class="card mb-3">
  <div class="card-header py-2"><strong class="small">Datos de la actividad a asignar</strong></div>
  <div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small mb-1">Nombre de la actividad <span class="text-danger">*</span></label>
        <input type="text" class="form-control form-control-sm" id="defNombre" placeholder="Ej: Instalación en obra">
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1">Tipo <span class="text-danger">*</span></label>
        <select class="form-select form-select-sm" id="defTipo">
          <option value="">Seleccionar...</option>
          <% tiposActividad.forEach(function(t) { %>
          <option value="<%= t.ID_Tipo_Actividad %>" <%= ultimoTipoId === t.ID_Tipo_Actividad ? 'selected' : '' %>><%= t.Nombre %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-1">Empresa <span class="text-danger">*</span></label>
        <select class="form-select form-select-sm" id="defEmpresa">
          <option value="">Seleccionar...</option>
          <% empresas.forEach(function(emp) { %>
          <option value="<%= emp.ID_Empresa %>" <%= ultimaEmpresaId === emp.ID_Empresa ? 'selected' : '' %>><%= emp.Nombre_Empresa %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <div class="form-check form-switch mb-1">
          <input class="form-check-input" type="checkbox" id="chkRecurrente">
          <label class="form-check-label small" for="chkRecurrente">
            <i class="bi bi-arrow-repeat"></i> Repetir cada semana
          </label>
        </div>
        <small class="text-body-secondary" style="font-size:.7rem">
          Activo: el clic crea una regla semanal en ese día.
        </small>
      </div>
    </div>
  </div>
</div>

<!-- Calendario editable -->
<style>
  .cal-act th, .cal-act td { font-size:.78rem; white-space:nowrap; vertical-align:middle; }
  .cal-act .col-emp { position:sticky; left:0; background:#fff; z-index:2; min-width:180px; }
  .cal-act thead .col-emp { z-index:3; background:#f8f9fa; }
  .cal-act .th-sab { background:#fff3cd; }
  .celda-act {
    cursor:pointer; text-align:center; padding:.35rem .25rem; min-width:78px;
    border:1px solid #dee2e6; transition:background .12s;
  }
  .celda-act:hover { background:#e9ecef; }
  .celda-act.tiene-actividad { background:#e2d9f3; }
  .celda-act.tiene-actividad:hover { background:#d3c4ee; }
  .celda-act.ocupada-loading { opacity:.45; pointer-events:none; }
  /* Preview del rectángulo mientras se arrastra sobre varias celdas */
  .celda-act.en-seleccion { outline:2px solid #0d6efd; outline-offset:-2px; background:#cfe2ff !important; }
  .cal-act-tabla { user-select:none; }
  .celda-act .act-nombre { font-weight:600; color:#6f42c1; display:block; overflow:hidden; text-overflow:ellipsis; max-width:110px; }
  .celda-act .act-tipo { font-size:.68rem; color:#6c757d; display:block; }
</style>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-bordered mb-0 cal-act cal-act-tabla">
        <thead class="table-light">
          <tr>
            <th class="col-emp">Empleado</th>
            <% const DIAS_CORTO = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb']; %>
            <% fechas.forEach(function(f) { %>
            <th class="text-center <%= f.getDay() === 6 ? 'th-sab' : '' %>">
              <%= DIAS_CORTO[f.getDay()] %><br>
              <small class="text-body-secondary"><%= String(f.getDate()).padStart(2,'0') %>/<%= String(f.getMonth()+1).padStart(2,'0') %></small>
            </th>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% equipo.forEach(function(emp) { %>
          <tr>
            <td class="col-emp">
              <%= [emp.Nombre, emp.Apellido_Paterno, emp.Apellido_Materno].filter(Boolean).join(' ') %>
            </td>
            <% fechas.forEach(function(f) { %>
              <%
                const ymd = f.toISOString().slice(0,10);
                const act = celdas.get(emp.ID_Empleado + '_' + ymd) || null;
              %>
              <td class="celda-act <%= act ? 'tiene-actividad' : '' %>"
                  style="<%= act && act.color ? 'background-color:' + act.color + '22;' : '' %>"
                  data-empleado="<%= emp.ID_Empleado %>"
                  data-fecha="<%= ymd %>"
                  title="<%= act ? 'Tipo: ' + act.tipo + ' · ' + act.nombre + (act.empresa ? ' · ' + act.empresa : '') + (act.esRecurrente ? ' · recurrente' : ' · puntual') : 'Sin actividad — clic para asignar' %>">
                <% if (act) { %>
                  <span class="act-nombre" style="color:<%= act.color %>"><%= act.nombre %></span>
                  <span class="act-tipo">
                    <%= act.empresa || '' %><% if (act.esRecurrente) { %> <i class="bi bi-arrow-repeat"></i><% } %>
                  </span>
                <% } else { %>
                  <span class="text-body-secondary">+</span>
                <% } %>
              </td>
            <% }); %>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row mt-3">
  <% if (actividadesDelRango && actividadesDelRango.length > 0) { %>
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header py-2">
        <i class="bi bi-pencil-square me-2"></i><strong class="small">Actividades de este rango</strong>
        <small class="text-body-secondary d-block" style="font-size:.72rem">Entra a una para corregir sus datos o gestionar sus días en bloque.</small>
      </div>
      <div class="list-group list-group-flush">
        <% actividadesDelRango.forEach(function(a) { %>
        <a href="/encargado/actividades/<%= a.ID_Actividad %>" class="list-group-item list-group-item-action d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
          <div>
            <span class="fw-semibold" style="color:<%= a.tipo_actividad.Color %>"><%= a.Nombre_Actividad %></span>
            <small class="text-body-secondary ms-2"><%= a.empresa.Nombre_Empresa %></small>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary"><%= a._count.asignaciones %> día(s)</span>
            <i class="bi bi-chevron-right text-body-secondary"></i>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>

  <% if (recurrenciasDelRango && recurrenciasDelRango.length > 0) { %>
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header py-2">
        <i class="bi bi-arrow-repeat me-2"></i><strong class="small">Recurrencias vigentes</strong>
        <small class="text-body-secondary d-block" style="font-size:.72rem">Entra a una para cambiar sus datos, sus días de la semana o su vigencia.</small>
      </div>
      <div class="list-group list-group-flush">
        <% recurrenciasDelRango.forEach(function(r) { %>
        <a href="/encargado/recurrencias/<%= r.ID_Recurrencia %>" class="list-group-item list-group-item-action d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
          <div>
            <span class="fw-semibold" style="color:<%= r.color %>"><%= r.nombre %></span>
            <small class="text-body-secondary ms-2"><%= r.empleado %> · <%= r.empresa %></small>
          </div>
          <div class="d-flex align-items-center gap-1">
            <% r.dias.sort().forEach(function(d) { %>
              <span class="badge bg-light text-dark border" style="font-size:.65rem"><%= nombresDia[d].slice(0,3) %></span>
            <% }); %>
            <i class="bi bi-chevron-right text-body-secondary ms-1"></i>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>
</div>

<!-- Panel lateral: editar la actividad de un día concreto -->
<style>
  #panelDiaCal .dato-lbl { font-size:.72rem; color:#6c757d; text-transform:uppercase; }
</style>
<div class="offcanvas offcanvas-end" tabindex="-1" id="panelDiaCal" style="width:420px">
  <div class="offcanvas-header border-bottom">
    <div>
      <h6 class="offcanvas-title mb-0" id="pcalNombre">—</h6>
      <small class="text-body-secondary" id="pcalFecha">—</small>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body">
    <div id="pcalCargando" class="text-center text-body-secondary py-4">
      <div class="spinner-border spinner-border-sm me-2"></div>Cargando...
    </div>

    <div id="pcalContenido" class="d-none">
      <div class="card mb-3">
        <div class="card-header py-2"><strong class="small">Checadas del día</strong></div>
        <div class="card-body py-2" id="pcalChecadas"></div>
      </div>

      <div class="card">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
          <strong class="small">Actividad</strong>
          <span class="badge bg-secondary d-none" id="pcalBadgeRec"><i class="bi bi-arrow-repeat"></i> Recurrente</span>
        </div>
        <div class="card-body">
          <!-- Aviso para días cubiertos por una regla semanal: lo que se
               guarda es una excepción de ESE día, la regla no se toca. -->
          <div class="alert alert-info py-2 px-3 small d-none" id="pcalAvisoRec">
            <i class="bi bi-info-circle me-1"></i>
            Este día lo cubre una <strong>recurrencia</strong>. Si lo cambias, se guarda como
            <strong>excepción solo de este día</strong> — la regla sigue aplicando las demás semanas.
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">Nombre</label>
            <input type="text" class="form-control form-control-sm" id="pcalNombreAct" placeholder="Ej: Instalación en obra">
          </div>
          <div class="mb-2">
            <label class="form-label small mb-1">Tipo</label>
            <select class="form-select form-select-sm" id="pcalTipo"></select>
          </div>
          <div class="mb-3">
            <label class="form-label small mb-1">Empresa</label>
            <select class="form-select form-select-sm" id="pcalEmpresa"></select>
          </div>

          <div class="mb-3 d-none" id="pcalHorasWrap">
            <label class="form-label small mb-1">Horario de la actividad</label>
            <div class="row g-2">
              <div class="col-6"><input type="time" class="form-control form-control-sm" id="pcalHoraIni" title="Desde"></div>
              <div class="col-6"><input type="time" class="form-control form-control-sm" id="pcalHoraFin" title="Hasta"></div>
            </div>
            <div class="d-flex justify-content-between align-items-start mt-1 gap-2">
              <small class="text-body-secondary" id="pcalHorasAyuda" style="font-size:.72rem"></small>
              <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none flex-shrink-0" id="pcalHorasGuardar" style="font-size:.75rem">
                Guardar horario
              </button>
            </div>
          </div>

          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="pcalRecurrente">
            <label class="form-check-label small" for="pcalRecurrente" id="pcalRecLabel">
              <i class="bi bi-arrow-repeat"></i> Repetir cada semana este día
            </label>
          </div>

          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-primary flex-grow-1" id="pcalGuardar">
              <i class="bi bi-check-lg me-1"></i>Guardar
            </button>
            <button type="button" class="btn btn-sm btn-success d-none" id="pcalAgregar"
                    title="Suma otra actividad a este día, sin quitar la que ya está">
              <i class="bi bi-plus-lg me-1"></i>Agregar otra
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger d-none" id="pcalQuitar">
              <i class="bi bi-trash me-1"></i>Quitar
            </button>
          </div>
          <div class="small text-danger mt-2 d-none" id="pcalError"></div>
          <a href="#" id="pcalLink" class="small d-none d-block mt-2">
            <i class="bi bi-box-arrow-up-right me-1"></i>Abrir la actividad completa
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
<script>
(function(){
  // --- Selector de rango ---
  const fi = document.getElementById('fechaInicio');
  const ff = document.getElementById('fechaFin');
  const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  flatpickr('#rango', {
    mode: 'range',
    locale: 'es',
    dateFormat: 'Y-m-d',
    defaultDate: [fi.value, ff.value],
    onChange: function(dates){
      if (dates.length === 2) { fi.value = fmt(dates[0]); ff.value = fmt(dates[1]); }
    }
  });

  // --- Toggle de celdas ---
  const defNombre = document.getElementById('defNombre');
  const defTipo = document.getElementById('defTipo');
  const defEmpresa = document.getElementById('defEmpresa');
  const chkRecurrente = document.getElementById('chkRecurrente');
  const idEncargado = <%= esSupervisorParaDelegar ? idEncargadoPreseleccionado : 'null' %>;

  function pintar(td, estado, act) {
    td.classList.toggle('tiene-actividad', estado !== 'VACIO');
    if (estado === 'VACIO' || !act) {
      td.innerHTML = '<span class="text-body-secondary">+</span>';
      td.style.backgroundColor = '';
      td.title = 'Sin actividad — clic para asignar';
      return;
    }
    const color = act.color || '#6f42c1';
    const rec = act.esRecurrente ? ' <i class="bi bi-arrow-repeat"></i>' : '';
    td.style.backgroundColor = color + '22';
    td.innerHTML = '<span class="act-nombre"></span><span class="act-tipo"></span>';
    const nom = td.querySelector('.act-nombre');
    nom.textContent = act.nombre;
    nom.style.color = color;
    td.querySelector('.act-tipo').innerHTML = (act.empresa || '') + rec;
    td.title = 'Tipo: ' + (act.tipo || '') + ' · ' + act.nombre + (act.empresa ? ' · ' + act.empresa : '') + (act.esRecurrente ? ' · recurrente' : ' · puntual');
  }

  // Aplica el toggle a UNA celda. Devuelve una promesa que nunca rechaza:
  // resuelve con el mensaje de error (o null si salió bien), para poder
  // procesar un lote sin que un fallo corte el resto.
  function toggleCelda(td) {
    const tieneActividad = td.classList.contains('tiene-actividad');
    const body = {
      ID_Empleado: parseInt(td.dataset.empleado),
      fecha: td.dataset.fecha,
      modo: chkRecurrente.checked ? 'RECURRENTE' : 'PUNTUAL'
    };
    if (idEncargado) body.ID_Encargado_Empleado = idEncargado;

    // Solo se exigen los valores por defecto cuando la celda va a CREAR algo.
    if (!tieneActividad) {
      body.Nombre_Actividad = defNombre.value.trim();
      body.ID_Tipo_Actividad = defTipo.value;
      body.ID_Empresa = defEmpresa.value;
      if (!body.Nombre_Actividad || !body.ID_Tipo_Actividad || !body.ID_Empresa) {
        return Promise.resolve('FALTAN_DEFAULTS');
      }
    }

    td.classList.add('ocupada-loading');
    return fetch('/encargado/actividades/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
      .then(function(r){ return r.json(); })
      .then(function(res){
        if (!res.ok) return res.error || 'No se pudo actualizar la actividad';
        pintar(td, res.estado, res.actividad);
        return null;
      })
      .catch(function(){ return 'Error de conexión'; })
      .finally(function(){ td.classList.remove('ocupada-loading'); });
  }

  // --- Selección por arrastre (rectángulo empleado × días) ---
  const celdas = Array.from(document.querySelectorAll('.celda-act'));
  // Índice fila/columna de cada celda, para calcular el rectángulo arrastrado.
  celdas.forEach(function(td){
    td.dataset.fila = td.parentElement.rowIndex;
    td.dataset.col = td.cellIndex;
  });

  let arrastrando = false, inicio = null, movio = false;

  function enRectangulo(a, b) {
    const f1 = Math.min(+a.dataset.fila, +b.dataset.fila), f2 = Math.max(+a.dataset.fila, +b.dataset.fila);
    const c1 = Math.min(+a.dataset.col, +b.dataset.col), c2 = Math.max(+a.dataset.col, +b.dataset.col);
    return celdas.filter(function(td){
      const f = +td.dataset.fila, c = +td.dataset.col;
      return f >= f1 && f <= f2 && c >= c1 && c <= c2;
    });
  }

  function pintarPreview(lista) {
    celdas.forEach(function(td){ td.classList.remove('en-seleccion'); });
    lista.forEach(function(td){ td.classList.add('en-seleccion'); });
  }

  celdas.forEach(function(td){
    td.addEventListener('mousedown', function(ev){
      ev.preventDefault(); // evita selección de texto al arrastrar
      arrastrando = true; movio = false; inicio = td;
      pintarPreview([td]);
    });
    td.addEventListener('mouseenter', function(){
      if (!arrastrando || !inicio) return;
      movio = true;
      pintarPreview(enRectangulo(inicio, td));
    });
  });

  document.addEventListener('mouseup', function(){
    if (!arrastrando || !inicio) return;
    const seleccion = celdas.filter(function(td){ return td.classList.contains('en-seleccion'); });
    arrastrando = false;
    pintarPreview([]);
    if (seleccion.length === 0) { inicio = null; return; }

    // Un solo clic sin arrastre: comportamiento de siempre.
    const lote = movio ? seleccion : [inicio];
    const unaSola = lote.length === 1;
    inicio = null;

    const hayDefaults = defNombre.value.trim() && defTipo.value && defEmpresa.value;

    // Clic simple sin datos arriba: abrir el panel para capturar (si la celda
    // está vacía) o editar (si ya tiene actividad). Los datos de arriba son el
    // atajo para asignar en bloque; el panel es la vía para un día concreto.
    if (unaSola && !hayDefaults) {
      if (window.__abrirPanelCal) { window.__abrirPanelCal(lote[0]); return; }
    }

    // Arrastre en bloque: ahí sí hacen falta los datos de arriba, porque el
    // panel es de un solo día.
    const necesitaDefaults = lote.some(function(td){ return !td.classList.contains('tiene-actividad'); });
    if (necesitaDefaults && !hayDefaults) {
      alert('Para asignar varios días a la vez, completa nombre, tipo y empresa arriba');
      defNombre.focus();
      return;
    }

    // Secuencial: el backend valida traslapes fila por fila; en paralelo
    // podrían chocar dos celdas del mismo empleado y día.
    const errores = [];
    lote.reduce(function(cadena, td){
      return cadena.then(function(){
        return toggleCelda(td).then(function(err){ if (err && err !== 'FALTAN_DEFAULTS') errores.push(err); });
      });
    }, Promise.resolve()).then(function(){
      if (errores.length) {
        const unicos = errores.filter(function(e, i){ return errores.indexOf(e) === i; });
        alert(lote.length > 1
          ? errores.length + ' de ' + lote.length + ' celda(s) no se pudieron actualizar:\n\n' + unicos.slice(0, 4).join('\n')
          : unicos[0]);
      }
    });
  });

  // ---------- Panel lateral: editar la actividad de un día ----------
  // Se abre al hacer clic en una celda CON actividad cuando arriba no hay
  // datos capturados (si los hay, el clic reemplaza directo, sin abrir nada).
  const panelEl = document.getElementById('panelDiaCal');
  const panelCal = panelEl ? new bootstrap.Offcanvas(panelEl) : null;
  const $$ = id => document.getElementById(id);
  let ctxCal = { emp: null, fecha: null, idAsignacion: null, esRecurrente: false, idRecurrencia: null };

  function errCal(msg) {
    const e = $$('pcalError');
    e.textContent = msg || '';
    e.classList.toggle('d-none', !msg);
  }

  function abrirPanel(td) {
    ctxCal = { emp: td.dataset.empleado, fecha: td.dataset.fecha, idAsignacion: null, esRecurrente: false, idRecurrencia: null };
    errCal('');
    $$('pcalCargando').classList.remove('d-none');
    $$('pcalContenido').classList.add('d-none');
    panelCal.show();

    fetch('/encargado/asistencia/dia?empleado=' + ctxCal.emp + '&fecha=' + ctxCal.fecha +
          (idEncargado ? '&encargado=' + idEncargado : ''))
      .then(r => r.json())
      .then(function(d){
        if (!d.ok) { errCal(d.error || 'No se pudo cargar el día'); $$('pcalCargando').classList.add('d-none'); return; }
        const act = d.actividad;
        ctxCal.idAsignacion = act ? act.ID_Asignacion : null;
        ctxCal.esRecurrente = !!(act && act.esRecurrente);
        ctxCal.idRecurrencia = act ? act.ID_Recurrencia : null;

        $$('pcalNombre').textContent = d.empleado.nombre;
        $$('pcalFecha').textContent = new Date(d.fecha + 'T12:00:00')
          .toLocaleDateString('es-MX', { weekday:'long', day:'2-digit', month:'long' });

        // Checadas reales del día, para decidir el horario con contexto.
        const ch = $$('pcalChecadas');
        if (d.asistencia) {
          ch.innerHTML = '<div class="row g-2"><div class="col-4"><div class="dato-lbl">Entrada</div><div class="fw-semibold">' +
            (d.asistencia.entrada || '--:--') + '</div></div><div class="col-4"><div class="dato-lbl">Salida</div><div class="fw-semibold">' +
            (d.asistencia.salida || '--:--') + '</div></div><div class="col-4"><div class="dato-lbl">Horas</div><div class="fw-semibold">' +
            d.asistencia.horas.toFixed(1) + 'h</div></div></div>';
        } else {
          ch.innerHTML = '<div class="text-body-secondary small">Sin checadas ese día.</div>';
        }

        // Sin actividad: precargar lo que haya escrito arriba, como punto de
        // partida (el panel es la vía para un día concreto).
        $$('pcalNombreAct').value = act ? act.nombre : defNombre.value.trim();
        // En un día cubierto por recurrencia el switch arranca APAGADO: lo
        // normal ahí es registrar una excepción de ese día (ej. "ese viernes
        // fui a capacitación"), no reescribir la regla de todas las semanas.
        $$('pcalRecurrente').checked = act ? false : chkRecurrente.checked;
        $$('pcalBadgeRec').classList.toggle('d-none', !ctxCal.esRecurrente);
        $$('pcalAvisoRec').classList.toggle('d-none', !ctxCal.esRecurrente);
        $$('pcalQuitar').classList.toggle('d-none', !act);
        // Agregar otra solo aplica si el día ya tiene algo.
        $$('pcalAgregar').classList.toggle('d-none', !act);
        // Sobre una recurrencia, "Quitar" detiene la regla completa: se avisa.
        $$('pcalQuitar').title = ctxCal.esRecurrente
          ? 'Detiene la regla completa (deja de aplicar todas las semanas)'
          : 'Quita la actividad de este día';
        // Sobre una recurrencia, encender el switch REEMPLAZA la regla; fuera
        // de ese caso, la crea. El texto lo aclara.
        $$('pcalRecLabel').innerHTML = ctxCal.esRecurrente
          ? '<i class="bi bi-arrow-repeat"></i> Reemplazar la regla de todas las semanas'
          : '<i class="bi bi-arrow-repeat"></i> Repetir cada semana este día';

        const opts = (sel, items, k, l, s) => {
          sel.innerHTML = '<option value="">Seleccionar...</option>' + items.map(function(i){
            return '<option value="' + i[k] + '"' + (String(i[k]) === String(s) ? ' selected' : '') + '>' + i[l] + '</option>';
          }).join('');
        };
        let tSel = '', eSel = '';
        if (act) {
          const t = d.tiposActividad.filter(x => x.Nombre === act.tipo)[0];
          if (t) tSel = t.ID_Tipo_Actividad;
          const em = d.empresas.filter(x => x.Nombre_Empresa === act.empresa)[0];
          if (em) eSel = em.ID_Empresa;
        } else {
          // Celda vacía: heredar lo elegido arriba, si hay algo.
          tSel = defTipo.value || '';
          eSel = defEmpresa.value || '';
        }
        opts($$('pcalTipo'), d.tiposActividad, 'ID_Tipo_Actividad', 'Nombre', tSel);
        opts($$('pcalEmpresa'), d.empresas, 'ID_Empresa', 'Nombre_Empresa', eSel);

        // Horario: disponible al crear una puntual y al editarla. Solo se
        // oculta en las recurrentes, que no materializan un día editable.
        const wrapH = $$('pcalHorasWrap');
        // Horario siempre visible: en un día recurrente sirve para el tramo
        // de la actividad ADICIONAL que se vaya a agregar.
        const hhmm = m => Number.isFinite(m)
          ? String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0') : '';
        $$('pcalHoraIni').value = (act && !ctxCal.esRecurrente) ? hhmm(act.horaInicio) : '';
        $$('pcalHoraFin').value = (act && !ctxCal.esRecurrente) ? hhmm(act.horaFin) : '';
        $$('pcalHorasAyuda').textContent = ctxCal.esRecurrente
          ? 'Necesario para agregar otra actividad a este día.'
          : (act && Number.isFinite(act.horaInicio) && Number.isFinite(act.horaFin))
            ? 'Solo cuenta este tramo; se suma a la checada.'
            : (d.asistencia ? 'Vacío: cuenta de 8:00 a su primera checada.' : 'Vacío: jornada completa (9h).');
        $$('pcalHorasGuardar').classList.toggle('d-none', !act || !act.ID_Asignacion || ctxCal.esRecurrente);
        wrapH.classList.remove('d-none');

        // Enlace a la pantalla que gestiona TODOS los días de esa actividad.
        const link = $$('pcalLink');
        if (act && (act.ID_Actividad || act.ID_Recurrencia)) {
          link.href = act.esRecurrente
            ? '/encargado/recurrencias/' + act.ID_Recurrencia
            : '/encargado/actividades/' + act.ID_Actividad;
          link.textContent = act.esRecurrente ? 'Abrir la regla completa' : 'Abrir la actividad completa';
          link.classList.remove('d-none');
        } else {
          link.classList.add('d-none');
        }

        $$('pcalCargando').classList.add('d-none');
        $$('pcalContenido').classList.remove('d-none');
      })
      .catch(function(){ errCal('Error de conexión'); $$('pcalCargando').classList.add('d-none'); });
  }

  if (panelCal) {
    // Guardar (crear o reemplazar) desde el panel.
    $$('pcalGuardar').addEventListener('click', function(){
      const nombre = $$('pcalNombreAct').value.trim();
      const tipo = $$('pcalTipo').value;
      const empresa = $$('pcalEmpresa').value;
      if (!nombre || !tipo || !empresa) { errCal('Completa nombre, tipo y empresa'); return; }

      const body = {
        ID_Empleado: parseInt(ctxCal.emp),
        fecha: ctxCal.fecha,
        modo: $$('pcalRecurrente').checked ? 'RECURRENTE' : 'PUNTUAL',
        Nombre_Actividad: nombre,
        ID_Tipo_Actividad: tipo,
        ID_Empresa: empresa
      };
      if (idEncargado) body.ID_Encargado_Empleado = idEncargado;

      // Horario capturado en el mismo paso (solo aplica a puntuales).
      const hIni = $$('pcalHoraIni').value, hFin = $$('pcalHoraFin').value;
      if (!$$('pcalRecurrente').checked) {
        if (!!hIni !== !!hFin) { errCal('Captura ambas horas, o deja las dos vacías'); return; }
        if (hIni && hFin && hFin <= hIni) { errCal('La hora de fin debe ser posterior a la de inicio'); return; }
        if (hIni && hFin) { body.Hora_Inicio = hIni; body.Hora_Fin = hFin; }
      }

      errCal('');
      fetch('/encargado/actividades/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
      })
        .then(r => r.json())
        .then(function(res){
          if (!res.ok) { errCal(res.error || 'No se pudo guardar'); return; }
          window.location.reload();
        })
        .catch(function(){ errCal('Error de conexión'); });
    });

    // Sumar OTRA actividad al mismo día, sin quitar la que ya está.
    $$('pcalAgregar').addEventListener('click', function(){
      const nombre = $$('pcalNombreAct').value.trim();
      const tipo = $$('pcalTipo').value;
      const empresa = $$('pcalEmpresa').value;
      const hI = $$('pcalHoraIni').value, hF = $$('pcalHoraFin').value;
      if (!nombre || !tipo || !empresa) { errCal('Completa nombre, tipo y empresa'); return; }
      if (!hI || !hF) { errCal('Para agregar otra actividad al día, captura su horario'); return; }
      if (hF <= hI) { errCal('La hora de fin debe ser posterior a la de inicio'); return; }

      const body = {
        agregar: true,
        ID_Empleado: parseInt(ctxCal.emp),
        fecha: ctxCal.fecha,
        modo: 'PUNTUAL',
        Nombre_Actividad: nombre,
        ID_Tipo_Actividad: tipo,
        ID_Empresa: empresa,
        Hora_Inicio: hI,
        Hora_Fin: hF
      };
      if (idEncargado) body.ID_Encargado_Empleado = idEncargado;

      errCal('');
      fetch('/encargado/actividades/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
      })
        .then(r => r.json())
        .then(function(res){
          if (!res.ok) { errCal(res.error || 'No se pudo agregar'); return; }
          window.location.reload();
        })
        .catch(function(){ errCal('Error de conexión'); });
    });

    // Guardar solo el horario del día.
    $$('pcalHorasGuardar').addEventListener('click', function(){
      if (!ctxCal.idAsignacion) return;
      const ini = $$('pcalHoraIni').value, fin = $$('pcalHoraFin').value;
      if (!!ini !== !!fin) { errCal('Captura ambas horas, o deja las dos vacías'); return; }
      if (ini && fin && fin <= ini) { errCal('La hora de fin debe ser posterior'); return; }
      errCal('');
      fetch('/encargado/actividades/asignacion/' + ctxCal.idAsignacion + '/horas-json', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ Hora_Inicio: ini, Hora_Fin: fin })
      })
        .then(r => r.json())
        .then(function(res){
          if (!res.ok) { errCal(res.error || 'No se pudo guardar el horario'); return; }
          window.location.reload();
        })
        .catch(function(){ errCal('Error de conexión'); });
    });

    // Quitar la actividad del día.
    $$('pcalQuitar').addEventListener('click', function(){
      const body = {
        ID_Empleado: parseInt(ctxCal.emp),
        fecha: ctxCal.fecha,
        modo: ctxCal.esRecurrente ? 'RECURRENTE' : 'PUNTUAL'
      };
      if (idEncargado) body.ID_Encargado_Empleado = idEncargado;
      errCal('');
      fetch('/encargado/actividades/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
      })
        .then(r => r.json())
        .then(function(res){
          if (!res.ok) { errCal(res.error || 'No se pudo quitar'); return; }
          window.location.reload();
        })
        .catch(function(){ errCal('Error de conexión'); });
    });
  }

  // Expuesto para el handler de mouseup: decide entre reemplazo directo
  // (datos arriba llenos) y abrir el panel (datos vacíos).
  window.__abrirPanelCal = abrirPanel;
})();
</script>
<% } %>
